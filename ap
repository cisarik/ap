#!/bin/sh
set -eu

CANONICAL_URL="https://github.com/cisarik/ap.git"
SUBMODULE_PATH=".ap"
BEGIN_MARKER="<!-- BEGIN MANAGED AP INTEGRATION -->"
END_MARKER="<!-- END MANAGED AP INTEGRATION -->"

say() {
    printf '%s\n' "$*"
}

fail() {
    printf 'ap: ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage:
  ap init
  ap doctor [--candidate]
  ap project check --root <physical-root> --baseline <commit>
  ap project check --root <physical-root> --candidate
  ap exec --root <physical-root> --baseline <commit> --operation <id> -- <argv>
  ap update --check
  ap update --apply
  ap bundle <project> --initial [options]
  ap bundle <project> [options]
  ap bundle --help
  ap help

Commands:
  init                Create or refresh the managed AP block in the superproject AGENTS.md.
  doctor              Strict read-only health check for the committed .ap pin.
  doctor --candidate  Read-only health check for an intentional .ap update or rollback candidate.
  project check       Validate a baseline contract and CPython, or a non-authorizing candidate.
  exec                Run one baseline-declared operation in a sanitized direct-exec envelope.
  update --check      Check whether canonical AP main is a forward update.
  update --apply      Fetch canonical AP main and move only the .ap checkout to that commit.
  bundle              Export a ChatOrchestrator offline Git transport ZIP from a standalone AP checkout.

Integration commands run from an initialized .ap Git submodule, normally as
./.ap/ap. Project-check and exec commands accept an explicit physical root.
bundle runs from the standalone AP checkout, not from a consumer .ap submodule.
The tool never commits, pushes, modifies Git configuration, or copies AP
protocol files into the consuming project.
EOF
}

PROJECT_CONTRACT=ap.project.conf
PROJECT_CHILD_PATH=/usr/bin:/bin

project_clean_stage() {
    project_stage_argument=$1
    shift
    if [ "$project_stage_argument" = yes ] &&
        [ "${AP_PROJECT_CLEAN_STAGE:-}" = 1 ] &&
        [ "${PATH:-}" = "$PROJECT_CHILD_PATH" ] &&
        [ "${HOME:-}" = /nonexistent ] &&
        [ "${LC_ALL:-}" = C ] &&
        [ "${GIT_CONFIG_NOSYSTEM:-}" = 1 ]; then
        return 0
    fi

    case "$0" in
        */*) project_script=$0 ;;
        *) project_script=$(command -v "$0" 2>/dev/null || true) ;;
    esac
    [ -n "${project_script:-}" ] || fail "cannot resolve executable path for sanitized bootstrap"
    project_script_dir=${project_script%/*}
    project_script_name=${project_script##*/}
    [ "$project_script_dir" != "$project_script" ] || project_script_dir=.
    project_script_dir=$(cd "$project_script_dir" 2>/dev/null && pwd -P) ||
        fail "cannot resolve executable directory for sanitized bootstrap"
    project_script=$project_script_dir/$project_script_name

    project_loader_contamination=
    if [ "${LD_LIBRARY_PATH+x}" = x ]; then project_loader_contamination=LD_LIBRARY_PATH; fi
    if [ "${LD_PRELOAD+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}LD_PRELOAD"; fi
    if [ "${LD_AUDIT+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}LD_AUDIT"; fi
    if [ "${DYLD_LIBRARY_PATH+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}DYLD_LIBRARY_PATH"; fi
    if [ "${DYLD_FRAMEWORK_PATH+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}DYLD_FRAMEWORK_PATH"; fi
    if [ "${DYLD_INSERT_LIBRARIES+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}DYLD_INSERT_LIBRARIES"; fi
    unset LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT \
        DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH DYLD_INSERT_LIBRARIES

    [ -x /usr/bin/env ] || fail "trusted /usr/bin/env is required for sanitized bootstrap"
    [ -x /usr/bin/awk ] || fail "trusted /usr/bin/awk is required for contamination classification"
    project_other_contamination=$(
        /usr/bin/env | /usr/bin/awk -F= '
            $1 == "APPIMAGE" || $1 == "APPDIR" || $1 == "PATH" ||
            $1 == "BASH_ENV" || $1 == "ENV" || $1 == "KSH_ENV" ||
            $1 == "ZDOTDIR" || $1 == "SHELLOPTS" || $1 == "BASHOPTS" ||
            $1 == "CDPATH" || $1 == "PROMPT_COMMAND" || $1 == "SSH_AUTH_SOCK" ||
            $1 ~ /^LD_/ || $1 ~ /^DYLD_/ || $1 ~ /^PYTHON/ ||
            $1 ~ /^VIRTUAL_ENV/ || $1 ~ /^GIT_/ { print $1 }
        '
    )
    project_contamination=$project_loader_contamination
    if [ -n "$project_other_contamination" ]; then
        project_contamination="${project_contamination}${project_contamination:+
}$project_other_contamination"
    fi
    exec /usr/bin/env -i \
        PATH="$PROJECT_CHILD_PATH" \
        LC_ALL=C \
        HOME=/nonexistent \
        GIT_CONFIG_NOSYSTEM=1 \
        AP_PROJECT_CLEAN_STAGE=1 \
        AP_PARENT_CONTAMINATION="$project_contamination" \
        "$project_script" --ap-internal-sanitized-stage "$@"
}

report_parent_contamination() {
    if [ -n "${AP_PARENT_CONTAMINATION:-}" ]; then
        project_names=$(printf '%s\n' "$AP_PARENT_CONTAMINATION" | tr '\n' ' ' | sed 's/ $//')
        say "WARN sanitized inherited environment classes: $project_names"
    else
        say "OK inherited environment contamination markers: none"
    fi
}

require_git() {
    command -v git >/dev/null 2>&1 || fail "git is required"
}

physical_path() {
    [ -d "$1" ] || return 1
    (cd "$1" && pwd -P)
}

make_temp_dir_in() {
    parent=$1
    template=$parent/.ap-tool.XXXXXX
    tmp=$(mktemp -d "$template") || fail "cannot create temporary directory in $parent"
    printf '%s\n' "$tmp"
}

file_mode() {
    if stat -f %Lp "$1" >/dev/null 2>&1; then
        stat -f %Lp "$1"
    else
        stat -c %a "$1"
    fi
}

script_dir() {
    case "$0" in
        */*) path=$0 ;;
        *) path=$(command -v "$0" 2>/dev/null || true) ;;
    esac
    [ -n "${path:-}" ] || fail "cannot resolve executable path"
    dir=$(dirname "$path")
    physical_path "$dir" || fail "cannot resolve executable directory"
}

normalize_ap_url() {
    case "$1" in
        https://github.com/cisarik/ap|\
        https://github.com/cisarik/ap.git|\
        https://github.com/cisarik/ap/|\
        https://github.com/cisarik/ap.git/)
            printf '%s\n' "github.com/cisarik/ap"
            ;;
        *)
            return 1
            ;;
    esac
}

require_tool_repository() {
    require_git

    tool_dir=$(script_dir)
    ap_root=$(git -C "$tool_dir" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$ap_root" ] || fail "the ap tool must live inside a Git worktree"
    ap_root=$(physical_path "$ap_root") || fail "cannot resolve AP root"
    [ "$tool_dir" = "$ap_root" ] || fail "the ap executable must be at the AP repository root"

    export ap_root
}

require_context() {
    require_tool_repository

    super_root=$(git -C "$ap_root" rev-parse --show-superproject-working-tree 2>/dev/null || true)
    [ -n "$super_root" ] || fail "this command must run from an initialized .ap submodule"
    super_root=$(physical_path "$super_root") || fail "cannot resolve superproject root"

    expected_ap="$super_root/$SUBMODULE_PATH"
    [ -d "$expected_ap" ] || fail "superproject does not contain .ap"
    expected_ap=$(physical_path "$expected_ap") || fail "cannot resolve .ap path"
    [ "$ap_root" = "$expected_ap" ] || fail "AP submodule path must be .ap"

    export ap_root super_root
}

submodule_key_for_ap() {
    [ -f "$super_root/.gitmodules" ] || fail ".gitmodules is missing"

    matches=$(git -C "$super_root" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '$2 == ".ap" { print $1 }' || true)
    count=$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')
    [ "$count" = "1" ] || fail ".gitmodules must contain exactly one submodule path .ap"

    key=$(printf '%s\n' "$matches" | sed -n '1p')
    section=${key#submodule.}
    section=${section%.path}
    [ -n "$section" ] || fail "cannot resolve .gitmodules section for .ap"
    printf '%s\n' "$section"
}

verify_canonical_identity() {
    section=$(submodule_key_for_ap)
    modules_url=$(git -C "$super_root" config -f .gitmodules --get "submodule.$section.url" 2>/dev/null || true)
    [ -n "$modules_url" ] || fail ".gitmodules is missing URL for .ap"
    normalize_ap_url "$modules_url" >/dev/null || fail ".gitmodules URL for .ap is not canonical AP"

    origin_url=$(git -C "$ap_root" config --get remote.origin.url 2>/dev/null || true)
    [ -n "$origin_url" ] || fail ".ap origin remote is missing"
    normalize_ap_url "$origin_url" >/dev/null || fail ".ap origin remote is not canonical AP"
}

gitlink_sha() {
    entry=$(git -C "$super_root" ls-files -s -- "$SUBMODULE_PATH" 2>/dev/null || true)
    [ -n "$entry" ] || fail ".ap is not recorded in the superproject index"
    set -- $entry
    mode=$1
    sha=$2
    [ "$mode" = "160000" ] || fail ".ap is not recorded as a submodule gitlink"
    printf '%s\n' "$sha"
}

ap_head() {
    git -C "$ap_root" rev-parse HEAD
}

require_gitlink_consistent() {
    recorded=$(gitlink_sha)
    current=$(ap_head)
    [ "$recorded" = "$current" ] || fail ".ap worktree HEAD does not match the superproject gitlink"
}

require_submodule_clean() {
    status=$(git -C "$ap_root" status --porcelain=v1 --untracked-files=all)
    [ -z "$status" ] || fail ".ap submodule worktree is dirty"
}

require_superproject_clean() {
    status=$(git -C "$super_root" status --porcelain=v1 --untracked-files=all)
    [ -z "$status" ] || fail "superproject worktree or index is not clean"
}

managed_block() {
    cat <<'EOF'
<!-- BEGIN MANAGED AP INTEGRATION -->
## Analytic Programming

This project uses Analytic Programming through the pinned Git submodule at `.ap/`.
The exact AP version is the commit recorded by this repository's `.ap` gitlink.

Required reading:
- All participants read `.ap/AP.md`.
- Orchestrators also read `.ap/AP_ORCHESTRATOR.md`.
- Workers also read `.ap/AP_WORKER.md`.
- Prompt structures are in `.ap/PROMPT_CONTRACTS.md`.

Project-specific rules outside this managed block remain authoritative within
their scope. Task authority comes only from the current authoritative
Orchestrator prompt.

Treat `.ap/` as read-only during ordinary project work. Protocol updates require
a separate explicit AP update task.
<!-- END MANAGED AP INTEGRATION -->
EOF
}

marker_count() {
    file=$1
    marker=$2
    if [ ! -f "$file" ]; then
        printf '%s\n' 0
        return
    fi
    grep -cF "$marker" "$file" || true
}

validate_marker_shape() {
    file=$1
    begin_count=$(marker_count "$file" "$BEGIN_MARKER")
    end_count=$(marker_count "$file" "$END_MARKER")
    [ "$begin_count" = "1" ] || return 1
    [ "$end_count" = "1" ] || return 1
    awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { if (seen_begin || seen_end) exit 1; seen_begin = 1; next }
        $0 == end { if (!seen_begin || seen_end) exit 1; seen_end = 1; next }
        END { if (!seen_begin || !seen_end) exit 1 }
    ' "$file"
}

validate_agents_block() {
    file="$super_root/AGENTS.md"
    [ -f "$file" ] || fail "AGENTS.md is missing"
    validate_marker_shape "$file" || fail "AGENTS.md managed AP block is missing or malformed"

    tmpdir=$(make_temp_dir_in "${TMPDIR:-/tmp}")
    block="$tmpdir/block"
    expected="$tmpdir/expected"
    trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

    awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { in_block = 1 }
        in_block { print }
        $0 == end { in_block = 0 }
    ' "$file" > "$block"
    managed_block > "$expected"

    cmp -s "$expected" "$block" || fail "AGENTS.md managed AP block does not match the canonical block; run ./.ap/ap init"
}

require_no_competing_governing_ap_source() {
    file="$super_root/AGENTS.md"
    [ -f "$file" ] || return 0

    competing=$(awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        function active_outside_comments(value,    active, marker) {
            active = ""
            while (value != "") {
                if (in_comment) {
                    marker = index(value, "-->")
                    if (!marker) return active
                    value = substr(value, marker + 3)
                    in_comment = 0
                } else {
                    marker = index(value, "<!--")
                    if (!marker) return active value
                    active = active substr(value, 1, marker - 1)
                    value = substr(value, marker + 4)
                    in_comment = 1
                }
            }
            return active
        }
        function normalize_leading_list_markers(value,    previous) {
            while (value ~ /^[[:space:]]*([-+*][[:space:]]+|[0-9]+[.)][[:space:]]+)/) {
                previous = value
                sub(/^[[:space:]]*([-+*][[:space:]]+|[0-9]+[.)][[:space:]]+)/, "", value)
                if (value == previous) break
                list_item = 1
            }
            return value
        }
        $0 == begin { in_managed = 1; next }
        $0 == end { in_managed = 0; next }
        in_managed { next }
        {
            line = $0
            list_item = 0
            line = normalize_leading_list_markers(line)
        }
        /^[[:space:]]*>/ { next }
        line ~ /^[[:space:]]*>/ { next }
        in_fence {
            if (line ~ /^[[:space:]]*(```|~~~)/) in_fence = 0
            next
        }
        {
            comment_touched = in_comment
            line = active_outside_comments(line)
            if (comment_touched || index($0, "<!--")) {
                sub(/^[[:space:]]*/, "", line)
            }
            line = normalize_leading_list_markers(line)
        }
        line ~ /^[[:space:]]*>/ { next }
        line ~ /^[[:space:]]*(```|~~~)/ {
            in_fence = 1
            next
        }
        {
            if (list_item) sub(/^[[:space:]]*/, "", line)
            if (line ~ /^(Governing AP variant|Governing AP source|Governing AP repository|Additional governing AP source|Rules from non-governing AP variant|Apply governing AP rules from|Protocol rules also imported from):[[:space:]]*/) {
                print $0
            }
        }
    ' "$file")
    [ -z "$competing" ] ||
        fail "AGENTS.md declares another governing AP source, variant, or rule import outside the managed block"
}

resolve_stable_variant() {
    verify_canonical_identity
    require_gitlink_consistent
    validate_agents_block
    require_no_competing_governing_ap_source
    printf '%s\n' stable
}

write_agents_block() {
    file="$super_root/AGENTS.md"
    [ ! -L "$file" ] || fail "refusing to modify symlink AGENTS.md"

    begin_count=$(marker_count "$file" "$BEGIN_MARKER")
    end_count=$(marker_count "$file" "$END_MARKER")

    target_dir=$(dirname "$file")
    tmpdir=$(make_temp_dir_in "$target_dir")
    block="$tmpdir/block"
    out="$tmpdir/out"
    managed_block > "$block"

    cleanup_tmp() {
        rm -rf "$tmpdir"
    }
    trap cleanup_tmp EXIT HUP INT TERM

    if [ "$begin_count" = "0" ] && [ "$end_count" = "0" ]; then
        if [ -f "$file" ]; then
            cat "$file" > "$out"
            printf '\n\n' >> "$out"
            cat "$block" >> "$out"
        else
            {
                printf '%s\n\n' "# Agent Instructions"
                cat "$block"
            } > "$out"
        fi
    elif [ "$begin_count" = "1" ] && [ "$end_count" = "1" ]; then
        validate_marker_shape "$file" || fail "AGENTS.md managed AP markers are malformed"
        awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" -v block="$block" '
            $0 == begin {
                while ((getline line < block) > 0) print line
                in_block = 1
                next
            }
            $0 == end {
                in_block = 0
                next
            }
            in_block { next }
            { print }
        ' "$file" > "$out"
    else
        fail "AGENTS.md contains duplicate or conflicting managed AP markers"
    fi

    if [ -f "$file" ]; then
        mode=$(file_mode "$file") || fail "cannot read AGENTS.md mode"
        chmod "$mode" "$out" || fail "cannot preserve AGENTS.md mode"
    fi

    if [ "${AP_TEST_FAIL_BEFORE_AGENTS_MV:-}" = "1" ]; then
        fail "test-requested failure before AGENTS.md publication"
    fi

    if [ -f "$file" ] && cmp -s "$file" "$out"; then
        say "AGENTS.md unchanged"
    else
        mv "$out" "$file"
        say "AGENTS.md changed"
    fi
}

legacy_artifacts() {
    confirmed=
    review=
    for artifact in \
        AP.md APv2.md APv3.md AP_ORCHESTRATOR.md AP_WORKER.md \
        PROMPT_CONTRACTS.md ARTIFACT_LIFECYCLE.md BOOT_ORCHESTRATOR.md \
        BOOT_WORKER.md NEXT_ORCHESTRATOR.md NEXT_WORKER.md WORKERS.md
    do
        path=$super_root/$artifact
        [ -f "$path" ] || continue
        if is_confirmed_ap_copy "$artifact" "$path"; then
            confirmed="$confirmed $artifact"
        elif is_ap_session_artifact "$artifact" "$path"; then
            review="$review $artifact(session-state)"
        else
            review="$review $artifact(ambiguous-name)"
        fi
    done
    [ -n "$review" ] && printf 'WARN legacy-looking same-name files require review:%s\n' "$review" >&2
    [ -n "$confirmed" ] && printf '%s\n' "$confirmed"
    return 0
}

is_confirmed_ap_copy() {
    artifact=$1
    path=$2
    case "$artifact" in
        AP.md|APv2.md|APv3.md)
            head -n 5 "$path" | grep -E 'Analytic Programming Protocol' >/dev/null
            ;;
        AP_ORCHESTRATOR.md)
            head -n 5 "$path" | grep -F 'Orchestrator Handbook for Analytic Programming' >/dev/null
            ;;
        AP_WORKER.md)
            head -n 5 "$path" | grep -F 'Worker Handbook for Analytic Programming' >/dev/null
            ;;
        PROMPT_CONTRACTS.md)
            head -n 20 "$path" | grep -F 'Analytic Programming' >/dev/null && head -n 5 "$path" | grep -F 'Prompt Contracts' >/dev/null
            ;;
        ARTIFACT_LIFECYCLE.md)
            head -n 20 "$path" | grep -F 'Analytic Programming' >/dev/null && head -n 5 "$path" | grep -F 'Artifact Lifecycle' >/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

is_ap_session_artifact() {
    artifact=$1
    path=$2
    case "$artifact" in
        BOOT_ORCHESTRATOR.md|BOOT_WORKER.md|NEXT_ORCHESTRATOR.md|NEXT_WORKER.md|WORKERS.md)
            head -n 20 "$path" | grep -F 'Analytic Programming' >/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

cmd_init() {
    require_context
    verify_canonical_identity
    require_gitlink_consistent
    require_submodule_clean
    require_no_competing_governing_ap_source
    write_agents_block
    variant=$(resolve_stable_variant)
    say "OK resolved governing variant: $variant"
    say "ap init: PASS"
}

cmd_doctor() {
    require_context
    mode=${1:-strict}
    say "OK containing Git repository: $super_root"
    verify_canonical_identity
    say "OK canonical AP identity"
    recorded=$(gitlink_sha)
    current=$(ap_head)
    say "superproject recorded AP commit: $recorded"
    say ".ap worktree AP commit: $current"
    if [ "$mode" = "strict" ]; then
        [ "$recorded" = "$current" ] || fail ".ap HEAD $current does not match gitlink $recorded"
        say "OK strict pinned AP commit"
    elif [ "$mode" = "candidate" ]; then
        [ "$recorded" != "$current" ] || fail ".ap candidate mode requires a changed AP checkout"
        verify_candidate_superproject_state
        say "OK AP candidate checkout differs from the recorded gitlink"
    else
        fail "unknown doctor mode"
    fi
    require_submodule_clean
    say "OK .ap submodule clean"
    validate_agents_block
    say "OK managed AGENTS.md block"
    require_no_competing_governing_ap_source
    legacy=$(legacy_artifacts)
    [ -z "$legacy" ] || fail "confirmed copied AP artifacts present: $(printf '%s' "$legacy" | tr '\n' ' ')"
    if [ "$mode" = "strict" ]; then
        variant=$(resolve_stable_variant)
        say "OK resolved governing variant: $variant"
        say "ap doctor: PASS"
    else
        say "ap doctor --candidate: PASS"
    fi
}

verify_candidate_superproject_state() {
    status=$(git -C "$super_root" status --porcelain=v1 --untracked-files=all)
    filtered=$(printf '%s\n' "$status" | sed '/^$/d; /^[ MARC][ MD] \.ap$/d')
    [ -z "$filtered" ] || fail "candidate validation allows only the .ap gitlink to differ in the superproject"
}

fetch_remote_main() {
    git -C "$ap_root" fetch --quiet origin refs/heads/main || fail "cannot fetch canonical AP origin main"
    git -C "$ap_root" rev-parse FETCH_HEAD^{commit} || fail "cannot resolve canonical AP origin main"
}

classify_update() {
    current=$1
    available=$2
    if [ "$current" = "$available" ]; then
        printf '%s\n' current
    elif git -C "$ap_root" merge-base --is-ancestor "$current" "$available"; then
        printf '%s\n' forward
    elif git -C "$ap_root" merge-base --is-ancestor "$available" "$current"; then
        printf '%s\n' behind
    else
        printf '%s\n' divergent
    fi
}

require_target_ap_tool() {
    target=$1
    entry=$(git -C "$ap_root" ls-tree "$target" -- ap 2>/dev/null || true)
    set -- $entry
    [ "${1:-}" = "100755" ] && [ "${4:-}" = "ap" ] || fail "target AP commit does not contain an executable ap tool"
}

cmd_update_check() {
    require_context
    verify_canonical_identity
    require_submodule_clean
    require_gitlink_consistent
    current=$(ap_head)
    available=$(fetch_remote_main)
    classification=$(classify_update "$current" "$available")
    say "current pinned AP commit: $current"
    say "available canonical origin/main commit: $available"
    case "$classification" in
        current)
            say "update available: no"
            ;;
        forward)
            say "update available: yes"
            ;;
        behind)
            fail "canonical origin/main is behind the current AP commit; normal update refused"
            ;;
        divergent)
            fail "canonical origin/main diverges from the current AP commit; normal update refused"
            ;;
    esac
}

cmd_update_apply() {
    require_context
    verify_canonical_identity
    require_gitlink_consistent
    require_submodule_clean
    require_superproject_clean

    old=$(ap_head)
    new=$(fetch_remote_main)
    classification=$(classify_update "$old" "$new")

    say "old AP commit: $old"
    say "new AP commit: $new"

    if [ "$classification" = "current" ]; then
        say "ap update --apply: no update available"
        return
    fi
    [ "$classification" = "forward" ] || fail "normal update requires current AP HEAD to be an ancestor of canonical origin/main"
    require_target_ap_tool "$new"

    git -C "$ap_root" checkout --detach --quiet "$new" || fail "failed to move .ap to $new"
    say "ap update --apply: moved .ap to $new"
    say "Review with: git diff --submodule"
    say "Validate candidate with: ./.ap/ap doctor --candidate"
    say "Commit in the superproject only after compatibility review: git add .ap && git commit"
}

project_cleanup() {
    case "${project_tmp:-}" in
        /tmp/ap-project.*|/private/tmp/ap-project.*|/var/tmp/ap-project.*)
            rm -rf "$project_tmp"
            ;;
    esac
}

project_require_root() {
    project_requested_root=$1
    [ -n "$project_requested_root" ] || fail "--root requires a value"
    case "$project_requested_root" in
        /*) ;;
        *) fail "--root must be an absolute physical path" ;;
    esac
    project_root=$(physical_path "$project_requested_root") || fail "project root is not a directory"
    [ "$project_root" = "$project_requested_root" ] || fail "--root must already be the physical project root: $project_root"
    project_git_root=$(git -C "$project_root" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$project_git_root" ] || fail "--root is not a Git worktree"
    project_git_root=$(physical_path "$project_git_root") || fail "cannot resolve Git project root"
    [ "$project_git_root" = "$project_root" ] || fail "--root must name the Git worktree top level"
}

project_resolve_baseline() {
    project_requested_baseline=$1
    case "$project_requested_baseline" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]* ) ;;
        *) fail "--baseline must be a full lowercase commit object ID" ;;
    esac
    [ "${#project_requested_baseline}" -eq 40 ] || fail "--baseline must be a full 40-character commit object ID"
    project_baseline=$(git -C "$project_root" rev-parse --verify "$project_requested_baseline^{commit}" 2>/dev/null || true)
    [ "$project_baseline" = "$project_requested_baseline" ] || fail "baseline commit is missing or does not resolve exactly"
    git -C "$project_root" cat-file -e "$project_baseline:$PROJECT_CONTRACT" 2>/dev/null ||
        fail "baseline $project_baseline does not contain $PROJECT_CONTRACT"
}

project_config() {
    if [ "$project_contract_mode" = baseline ]; then
        git -C "$project_root" config --no-includes --blob "$project_baseline:$PROJECT_CONTRACT" "$@"
    else
        git -C "$project_root" config --no-includes --file "$project_root/$PROJECT_CONTRACT" "$@"
    fi
}

project_count_key() {
    project_count=$(project_config --null --get-all "$1" 2>/dev/null |
        awk 'BEGIN { RS="\0" } { count++ } END { print count + 0 }')
    printf '%s\n' "$project_count"
}

project_read_singleton() {
    project_read_key=$1
    project_read_label=$2
    project_read_required=$3
    project_read_count=$(project_count_key "$project_read_key")
    if [ "$project_read_required" = required ]; then
        [ "$project_read_count" -eq 1 ] || fail "$project_read_label must occur exactly once"
    else
        [ "$project_read_count" -le 1 ] || fail "$project_read_label may occur at most once"
        if [ "$project_read_count" -eq 0 ]; then
            project_read_value=
            return
        fi
    fi
    project_read_value=$(project_config --get "$project_read_key") || fail "cannot read $project_read_label"
    case "$project_read_value" in
        *'
'*) fail "$project_read_label must not contain a newline" ;;
    esac
    [ -n "$project_read_value" ] || fail "$project_read_label must not be empty"
}

project_validate_relative_path() {
    project_path_value=$1
    project_path_label=$2
    project_path_allow_dot=$3
    [ -n "$project_path_value" ] || fail "$project_path_label must not be empty"
    case "$project_path_value" in
        /*) fail "$project_path_label must be project-relative" ;;
        *//*|*/./*|./*|*/.) fail "$project_path_label is not a normalized project-relative path" ;;
    esac
    [ "$project_path_allow_dot" = yes ] || [ "$project_path_value" != . ] ||
        fail "$project_path_label must name a path below the project root"
    project_old_ifs=$IFS
    IFS=/
    set -- $project_path_value
    IFS=$project_old_ifs
    for project_component in "$@"; do
        [ "$project_component" != .. ] || fail "$project_path_label must not traverse with .."
        [ -n "$project_component" ] || fail "$project_path_label contains an empty component"
    done
}

project_require_inside_root() {
    project_inside_path=$1
    project_inside_label=$2
    case "$project_inside_path" in
        "$project_root"|"$project_root"/*) ;;
        *) fail "$project_inside_label resolves outside the project root" ;;
    esac
}

project_expected_id() {
    project_origin=$(git -C "$project_root" config --get remote.origin.url 2>/dev/null || true)
    [ -n "$project_origin" ] || fail "remote.origin.url is required to verify projectId"
    project_origin=${project_origin%/}
    project_origin=${project_origin%.git}
    case "$project_origin" in
        *://*) project_origin_path=${project_origin#*://}; project_origin_path=${project_origin_path#*/} ;;
        *@*:*) project_origin_path=${project_origin#*:} ;;
        *) fail "remote.origin.url cannot be mapped to a stable owner/project identifier" ;;
    esac
    project_origin_owner=${project_origin_path%/*}
    project_origin_repo=${project_origin_path##*/}
    project_origin_owner=${project_origin_owner##*/}
    [ -n "$project_origin_owner" ] && [ -n "$project_origin_repo" ] ||
        fail "remote.origin.url cannot be mapped to a stable owner/project identifier"
    printf '%s/%s\n' "$project_origin_owner" "$project_origin_repo"
}

project_validate_contract() {
    project_tmp=$(mktemp -d "${TMPDIR:-/tmp}/ap-project.XXXXXX") || fail "cannot create project-validation temporary directory"
    trap project_cleanup EXIT HUP INT TERM
    project_keys=$project_tmp/keys
    project_operations=$project_tmp/operations
    project_argv=$project_tmp/argv

    if [ "$project_contract_mode" = candidate ]; then
        [ -f "$project_root/$PROJECT_CONTRACT" ] || fail "candidate $PROJECT_CONTRACT is missing"
        [ ! -L "$project_root/$PROJECT_CONTRACT" ] || fail "candidate $PROJECT_CONTRACT must not be a symlink"
    fi
    project_config --list >/dev/null 2>&1 || fail "$PROJECT_CONTRACT is not valid Git-config syntax"
    project_config --name-only --get-regexp '.*' > "$project_keys" 2>/dev/null ||
        fail "$PROJECT_CONTRACT contains no configuration"

    : > "$project_operations"
    while IFS= read -r project_key; do
        project_key_lower=$(printf '%s\n' "$project_key" | tr '[:upper:]' '[:lower:]')
        case "$project_key_lower" in
            include.*|includeif.*) fail "include directives are forbidden in $PROJECT_CONTRACT" ;;
            ap.schemaversion|ap.projectid|ap.environmentpolicy|\
            runtime.cpython.kind|runtime.cpython.executable|runtime.cpython.requiredversion|\
            runtime.cpython.sourceroot|runtime.cpython.provenancemodule) ;;
            operation.*.workingdirectory|operation.*.argv|operation.*.allowtrailingargv)
                project_operation_id=${project_key_lower#operation.}
                project_operation_id=${project_operation_id%.*}
                case "$project_operation_id" in
                    ''|*[!a-z0-9_-]*|[-_]* ) fail "invalid operation identifier in key: $project_key" ;;
                esac
                printf '%s\n' "$project_operation_id" >> "$project_operations"
                ;;
            extension.*.*) ;;
            *) fail "unknown schema-v1 section or field: $project_key" ;;
        esac
    done < "$project_keys"
    sort -u "$project_operations" -o "$project_operations"
    [ -s "$project_operations" ] || fail "schema v1 requires at least one declared operation"

    project_read_singleton ap.schemaversion schemaVersion required
    project_schema_version=$project_read_value
    [ "$project_schema_version" = 1 ] || fail "unsupported project contract schemaVersion: $project_schema_version"
    project_read_singleton ap.projectid projectId required
    project_id=$project_read_value
    project_id_expected=$(project_expected_id)
    [ "$project_id" = "$project_id_expected" ] ||
        fail "projectId mismatch: contract names $project_id but repository identity is $project_id_expected"
    project_read_singleton ap.environmentpolicy environmentPolicy required
    project_environment_policy=$project_read_value
    [ "$project_environment_policy" = sanitized-v1 ] || fail "environmentPolicy must be sanitized-v1"

    project_read_singleton runtime.cpython.kind runtime.cpython.kind required
    project_runtime_kind=$project_read_value
    [ "$project_runtime_kind" = cpython ] || fail "runtime.cpython.kind must be cpython"
    project_read_singleton runtime.cpython.executable runtime.cpython.executable required
    project_runtime_relative=$project_read_value
    project_validate_relative_path "$project_runtime_relative" runtime.cpython.executable no
    project_read_singleton runtime.cpython.requiredversion runtime.cpython.requiredVersion required
    project_runtime_version=$project_read_value
    case "$project_runtime_version" in
        [0-9].[0-9]|[0-9].[0-9][0-9]) ;;
        *) fail "runtime.cpython.requiredVersion must be a major.minor version" ;;
    esac
    project_read_singleton runtime.cpython.sourceroot runtime.cpython.sourceRoot optional
    project_source_relative=$project_read_value
    project_read_singleton runtime.cpython.provenancemodule runtime.cpython.provenanceModule optional
    project_provenance_module=$project_read_value
    if [ -n "$project_provenance_module" ] && [ -z "$project_source_relative" ]; then
        fail "runtime.cpython.provenanceModule requires sourceRoot"
    fi
    if [ -n "$project_provenance_module" ]; then
        case "$project_provenance_module" in
            *[!A-Za-z0-9_.]*|.*|*.|*..*) fail "runtime.cpython.provenanceModule is not a valid module name" ;;
        esac
    fi

    if [ -n "$project_source_relative" ]; then
        project_validate_relative_path "$project_source_relative" runtime.cpython.sourceRoot yes
        [ -d "$project_root/$project_source_relative" ] || fail "declared CPython sourceRoot does not exist"
        project_source_root=$(physical_path "$project_root/$project_source_relative") || fail "cannot resolve CPython sourceRoot"
        project_require_inside_root "$project_source_root" runtime.cpython.sourceRoot
    else
        project_source_root=
    fi

    project_runtime_launch_path=$project_root/$project_runtime_relative
    [ -e "$project_runtime_launch_path" ] || fail "declared CPython executable does not exist; STOP and report the mismatch without repairing the environment"
    [ -x "$project_runtime_launch_path" ] || fail "declared CPython executable is not executable; STOP and report the mismatch without repairing the environment"
    project_runtime_validation_path=$(readlink -f "$project_runtime_launch_path" 2>/dev/null || true)
    [ -n "$project_runtime_validation_path" ] && [ -f "$project_runtime_validation_path" ] && [ -x "$project_runtime_validation_path" ] ||
        fail "declared CPython executable symlink chain cannot be resolved safely; STOP and report the mismatch"

    while IFS= read -r project_operation_id; do
        project_read_singleton "operation.$project_operation_id.workingdirectory" "operation.$project_operation_id.workingDirectory" required
        project_workdir_relative=$project_read_value
        project_validate_relative_path "$project_workdir_relative" "operation.$project_operation_id.workingDirectory" yes
        [ -d "$project_root/$project_workdir_relative" ] || fail "operation $project_operation_id workingDirectory does not exist"
        project_workdir=$(physical_path "$project_root/$project_workdir_relative") || fail "cannot resolve operation workingDirectory"
        project_require_inside_root "$project_workdir" "operation $project_operation_id workingDirectory"
        project_read_singleton "operation.$project_operation_id.allowtrailingargv" "operation.$project_operation_id.allowTrailingArgv" required
        case "$project_read_value" in true|false) ;; *) fail "operation.$project_operation_id.allowTrailingArgv must be true or false" ;; esac
        project_argv_count=$(project_count_key "operation.$project_operation_id.argv")
        [ "$project_argv_count" -ge 1 ] || fail "operation.$project_operation_id.argv requires at least one fixed argument"
        project_config --get-all "operation.$project_operation_id.argv" > "$project_argv.values" || fail "cannot read operation argv"
        [ "$(wc -l < "$project_argv.values" | tr -d ' ')" -eq "$project_argv_count" ] ||
            fail "operation.$project_operation_id.argv values must not contain newlines"
        while IFS= read -r project_fixed_arg; do
            [ -n "$project_fixed_arg" ] || fail "operation.$project_operation_id.argv values must not be empty"
        done < "$project_argv.values"
    done < "$project_operations"
}

project_validate_cpython() {
    project_probe='import importlib.util, os, sys, sysconfig
def stop(message):
    print("ap: CPython validation failed: " + message + "; STOP and report the mismatch; do not repair the environment", file=sys.stderr)
    raise SystemExit(1)
def inside(path, root):
    try:
        return os.path.commonpath((os.path.realpath(path), os.path.realpath(root))) == os.path.realpath(root)
    except ValueError:
        return False
expected_version, expected_executable, source_root, module = sys.argv[1:5]
observed_version = "%d.%d" % sys.version_info[:2]
if observed_version != expected_version:
    stop("required Python " + expected_version + ", observed " + observed_version)
executable = os.path.realpath(sys.executable)
if executable != os.path.realpath(expected_executable):
    stop("sys.executable does not match the declared executable target")
prefix = os.path.realpath(sys.prefix)
base_prefix = os.path.realpath(sys.base_prefix)
stdlib = os.path.realpath(sysconfig.get_path("stdlib") or "")
import encodings
encodings_origin = os.path.realpath(encodings.__file__ or "")
if not all(os.path.isabs(p) and os.path.exists(p) for p in (executable, prefix, base_prefix, stdlib, encodings_origin)):
    stop("executable, prefixes, stdlib, or encodings origin is missing or non-absolute")
if not (inside(stdlib, prefix) or inside(stdlib, base_prefix)):
    stop("stdlib is inconsistent with sys.prefix and sys.base_prefix")
if not inside(encodings_origin, stdlib):
    stop("encodings resolves outside the interpreter stdlib")
for value in (executable, prefix, base_prefix, stdlib, encodings_origin):
    lowered = value.lower()
    if "appimage" in lowered or "/.mount_" in lowered or "cursor" in lowered:
        stop("runtime provenance resolves through an AppImage/Cursor path")
if not sys.flags.no_user_site or not sys.dont_write_bytecode:
    stop("user-site behavior and bytecode writes are not disabled")
observed_pythonpath = os.environ.get("PYTHONPATH", "")
if source_root:
    if os.path.realpath(observed_pythonpath) != os.path.realpath(source_root):
        stop("PYTHONPATH is not exactly the declared sourceRoot")
    occurrences = sum(1 for item in sys.path if item and os.path.realpath(item) == os.path.realpath(source_root))
    if occurrences != 1:
        stop("declared sourceRoot is not injected exactly once")
else:
    if observed_pythonpath:
        stop("PYTHONPATH is present without a declared sourceRoot")
if module:
    spec = importlib.util.find_spec(module)
    if spec is None or not spec.origin or not inside(spec.origin, source_root):
        stop("provenance module resolves outside the declared sourceRoot")
print("OK CPython runtime: " + observed_version)
print("OK CPython executable: " + executable)
print("OK CPython stdlib: " + stdlib)
print("OK CPython encodings: " + encodings_origin)'
    project_probe_status=0
    if [ -n "$project_source_root" ]; then
        /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$project_source_root" \
            "$project_runtime_validation_path" -s -B -c "$project_probe" \
            "$project_runtime_version" "$project_runtime_validation_path" "$project_source_root" "$project_provenance_module" ||
            project_probe_status=$?
    else
        /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            "$project_runtime_validation_path" -s -B -c "$project_probe" \
            "$project_runtime_version" "$project_runtime_validation_path" "" "" ||
            project_probe_status=$?
    fi
    [ "$project_probe_status" -eq 0 ] ||
        fail "CPython runtime validation failed; STOP and report the mismatch without repairing Python or the workstation"
}

project_check_common() {
    report_parent_contamination
    require_git
    project_require_root "$1"
    project_contract_mode=$2
    if [ "$project_contract_mode" = baseline ]; then
        project_resolve_baseline "$3"
        say "OK trusted baseline contract: $project_baseline:$PROJECT_CONTRACT"
    else
        project_baseline=
        say "NOTICE candidate validation is configuration/readiness evidence only; execution trust: no"
    fi
    project_validate_contract
    project_validate_cpython
    say "OK project contract schema: 1"
    say "OK project identity: $project_id"
    say "OK environment policy: $project_environment_policy"
}

cmd_project() {
    [ "${1:-}" = check ] || fail "project requires check"
    shift
    project_cli_root=
    project_cli_baseline=
    project_cli_mode=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root) [ "$#" -ge 2 ] || fail "--root requires a value"; project_cli_root=$2; shift 2 ;;
            --baseline) [ "$#" -ge 2 ] || fail "--baseline requires a value"; [ -z "$project_cli_mode" ] || fail "choose exactly one of --baseline or --candidate"; project_cli_mode=baseline; project_cli_baseline=$2; shift 2 ;;
            --candidate) [ -z "$project_cli_mode" ] || fail "choose exactly one of --baseline or --candidate"; project_cli_mode=candidate; shift ;;
            *) fail "unknown project check option: $1" ;;
        esac
    done
    [ -n "$project_cli_root" ] || fail "project check requires --root"
    [ -n "$project_cli_mode" ] || fail "project check requires --baseline or --candidate"
    project_check_common "$project_cli_root" "$project_cli_mode" "$project_cli_baseline"
    if [ "$project_cli_mode" = baseline ]; then
        say "ap project check --baseline: PASS"
    else
        say "ap project check --candidate: PASS (non-authorizing)"
    fi
}

cmd_exec() {
    project_cli_root=
    project_cli_baseline=
    project_cli_operation=
    project_cli_separator=no
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root) [ "$#" -ge 2 ] || fail "--root requires a value"; project_cli_root=$2; shift 2 ;;
            --baseline) [ "$#" -ge 2 ] || fail "--baseline requires a value"; project_cli_baseline=$2; shift 2 ;;
            --operation) [ "$#" -ge 2 ] || fail "--operation requires a value"; project_cli_operation=$2; shift 2 ;;
            --) project_cli_separator=yes; shift; break ;;
            *) fail "unknown exec option: $1" ;;
        esac
    done
    [ -n "$project_cli_root" ] || fail "exec requires --root"
    [ -n "$project_cli_baseline" ] || fail "exec requires --baseline"
    [ -n "$project_cli_operation" ] || fail "exec requires --operation"
    case "$project_cli_operation" in ''|*[!a-z0-9_-]*|[-_]*) fail "invalid operation identifier" ;; esac
    project_trailing_count=$#
    [ "$project_cli_separator" = yes ] || [ "$project_trailing_count" -eq 0 ] || fail "trailing argv must follow --"

    project_check_common "$project_cli_root" baseline "$project_cli_baseline"
    grep -Fx "$project_cli_operation" "$project_operations" >/dev/null 2>&1 || fail "operation is not declared by the trusted baseline: $project_cli_operation"
    project_read_singleton "operation.$project_cli_operation.allowtrailingargv" "operation.$project_cli_operation.allowTrailingArgv" required
    project_allow_trailing=$project_read_value
    if [ "$project_trailing_count" -gt 0 ] && [ "$project_allow_trailing" != true ]; then
        fail "operation $project_cli_operation does not allow trailing argv"
    fi
    project_read_singleton "operation.$project_cli_operation.workingdirectory" "operation.$project_cli_operation.workingDirectory" required
    project_exec_workdir=$(physical_path "$project_root/$project_read_value") || fail "cannot resolve operation workingDirectory"
    project_config --get-all "operation.$project_cli_operation.argv" > "$project_argv"
    project_fixed_reverse=$(sed '1!G;h;$!d' "$project_argv")
    while IFS= read -r project_fixed_arg; do
        set -- "$project_fixed_arg" "$@"
    done <<EOF
$project_fixed_reverse
EOF
    if ! git -C "$project_root" diff --quiet --no-ext-diff --no-textconv "$project_baseline" -- "$PROJECT_CONTRACT"; then
        fail "worktree/baseline $PROJECT_CONTRACT drift forbids execution"
    fi
    say "OK execution trust: baseline $project_baseline"
    say "OK operation: $project_cli_operation"
    say "OK direct argv execution with absolute argv[0]"
    project_cleanup
    trap - EXIT HUP INT TERM
    cd "$project_exec_workdir"
    project_runtime_current_validation_path=$(readlink -f "$project_runtime_launch_path" 2>/dev/null || true)
    [ -n "$project_runtime_current_validation_path" ] &&
        [ -f "$project_runtime_current_validation_path" ] &&
        [ -x "$project_runtime_current_validation_path" ] ||
        fail "declared CPython executable target changed or became unavailable after validation; refusing execution"
    [ "$project_runtime_current_validation_path" = "$project_runtime_validation_path" ] ||
        fail "declared CPython executable target changed after validation; refusing execution"
    set -- "$project_runtime_launch_path" "$@"
    if [ -n "$project_source_root" ]; then
        exec /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$project_source_root" \
            AP_PROJECT_ROOT="$project_root" AP_BASELINE="$project_baseline" AP_OPERATION="$project_cli_operation" \
            "$@"
    else
        exec /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            AP_PROJECT_ROOT="$project_root" AP_BASELINE="$project_baseline" AP_OPERATION="$project_cli_operation" \
            "$@"
    fi
}

bundle_usage() {
    cat <<'EOF'
Usage:
  ap bundle <project> --initial
      [--root <physical-git-root>]
      [--projects-root <physical-directory>]
      [--companion-trace <physical-git-root>]
      [--include-submodule <project-relative-path>]...
      [--allow-path <project-relative-path>]...
      [--output-dir <absolute-directory>]
      [--replace-chain]

  ap bundle <project>
      [--root <physical-git-root>]
      [--include-submodule <project-relative-path>]...
      [--allow-path <project-relative-path>]...
      [--output-dir <absolute-directory>]

  ap bundle --help

Export a ChatOrchestrator offline Git transport ZIP from a standalone AP
checkout. The simple form ap bundle <project> --initial then ap bundle <project>
is the primary UX. --root is not required when $HOME/Projects/<project> exists
or a prior --initial recorded the mapping.

The ZIP contains Git bundle objects, not a working-tree archive. Ignored files
do not enter the package. The package is exact committed bundle evidence; it
does not prove current public branch state.

State is stored under ${XDG_STATE_HOME:-$HOME/.local/state}/ap/bundle/.
Optional user config: ${XDG_CONFIG_HOME:-$HOME/.config}/ap/bundle.conf
(bundle.projectsRoot, bundle.outputDir).
EOF
}

bundle_tmp_list=
bundle_cleanup() {
    trap - EXIT HUP INT TERM
    if [ -n "${bundle_tmp_list:-}" ]; then
        while IFS= read -r bundle_tmp_one; do
            [ -n "$bundle_tmp_one" ] || continue
            case "$bundle_tmp_one" in
                *'/ap-bundle.'*)
                    rm -rf -- "$bundle_tmp_one" || true
                    ;;
            esac
        done <<EOF
$bundle_tmp_list
EOF
        bundle_tmp_list=
    fi
}

# Register in this shell. Do not call from $(...): subshell state is discarded.
bundle_alloc_tmp() {
    bundle_tmp=$(mktemp -d "${TMPDIR:-/tmp}/ap-bundle.XXXXXX") || fail "cannot create temporary directory"
    case "$bundle_tmp" in
        *'/ap-bundle.'*)
            ;;
        *)
            rm -rf -- "$bundle_tmp" || true
            fail "unexpected temporary directory: $bundle_tmp"
            ;;
    esac
    if [ -z "${bundle_tmp_list:-}" ]; then
        bundle_tmp_list=$bundle_tmp
    else
        bundle_tmp_list="$bundle_tmp_list
$bundle_tmp"
    fi
}

bundle_git_c() {
    bundle_git_root=$1
    shift
    (
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
        git -C "$bundle_git_root" "$@"
    )
}

bundle_valid_project_name() {
    bundle_name=$1
    case "$bundle_name" in
        ''|*[!A-Za-z0-9._-]*|[!A-Za-z0-9]*)
            fail "invalid project name: use a slash-free name matching [A-Za-z0-9][A-Za-z0-9._-]*"
            ;;
    esac
}

bundle_has_dotdot_component() {
    bundle_rest=$1/
    while [ -n "$bundle_rest" ]; do
        bundle_comp=${bundle_rest%%/*}
        bundle_rest=${bundle_rest#*/}
        if [ "$bundle_comp" = .. ]; then
            return 0
        fi
    done
    return 1
}

bundle_require_relpath() {
    bundle_rel=$1
    bundle_rel_label=$2
    [ -n "$bundle_rel" ] || fail "$bundle_rel_label requires a value"
    case "$bundle_rel" in
        /*)
            fail "$bundle_rel_label must be a project-relative path"
            ;;
        '')
            fail "$bundle_rel_label requires a value"
            ;;
    esac
    case "$bundle_rel" in
        *$'\n'*|*$'\r'*)
            fail "$bundle_rel_label must not contain a newline"
            ;;
    esac
    if bundle_has_dotdot_component "$bundle_rel"; then
        fail "$bundle_rel_label must not contain .."
    fi
    case "$bundle_rel" in
        .|./*|*//*)
            fail "$bundle_rel_label is not a safe project-relative path"
            ;;
    esac
}

bundle_require_abs_existing() {
    bundle_abs=$1
    bundle_abs_label=$2
    [ -n "$bundle_abs" ] || fail "$bundle_abs_label requires a value"
    case "$bundle_abs" in
        /*) ;;
        *) fail "$bundle_abs_label must be an absolute physical path" ;;
    esac
    if bundle_has_dotdot_component "$bundle_abs"; then
        fail "$bundle_abs_label must not contain .."
    fi
    [ -d "$bundle_abs" ] || fail "$bundle_abs_label is not a directory"
    bundle_abs_phys=$(physical_path "$bundle_abs") || fail "cannot resolve $bundle_abs_label"
    [ "$bundle_abs_phys" = "$bundle_abs" ] || fail "$bundle_abs_label must already be the physical path: $bundle_abs_phys"
    printf '%s\n' "$bundle_abs_phys"
}

bundle_require_abs_git_root() {
    bundle_abs=$1
    bundle_abs_label=$2
    bundle_abs_phys=$(bundle_require_abs_existing "$bundle_abs" "$bundle_abs_label")
    bundle_abs_git=$(bundle_git_c "$bundle_abs_phys" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$bundle_abs_git" ] || fail "$bundle_abs_label is not a Git worktree"
    bundle_abs_git=$(physical_path "$bundle_abs_git") || fail "cannot resolve Git root for $bundle_abs_label"
    [ "$bundle_abs_git" = "$bundle_abs_phys" ] || fail "$bundle_abs_label must name the Git worktree top level"
    printf '%s\n' "$bundle_abs_phys"
}

bundle_sha256() {
    bundle_hash_file=$1
    [ -f "$bundle_hash_file" ] || fail "cannot checksum missing file: $bundle_hash_file"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$bundle_hash_file" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$bundle_hash_file" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$bundle_hash_file" | awk '{print $NF}'
    else
        fail "sha256sum, shasum, or openssl is required to checksum transport payloads"
    fi
}

bundle_origin_identity() {
    bundle_url=$1
    [ -n "$bundle_url" ] || return 1
    bundle_id=$bundle_url
    case "$bundle_id" in
        git@*)
            bundle_id=${bundle_id#git@}
            bundle_id=$(printf '%s\n' "$bundle_id" | sed 's/:/\//')
            ;;
        ssh://git@*)
            bundle_id=${bundle_id#ssh://git@}
            ;;
        ssh://*)
            bundle_id=${bundle_id#ssh://}
            ;;
        https://*)
            bundle_id=${bundle_id#https://}
            ;;
        http://*)
            bundle_id=${bundle_id#http://}
            ;;
    esac
    bundle_id=${bundle_id%/}
    case "$bundle_id" in
        *.git)
            bundle_id=${bundle_id%.git}
            ;;
    esac
    printf '%s\n' "$bundle_id"
}

bundle_user_home() {
    [ -n "${HOME:-}" ] || fail "HOME is required for bundle state and project resolution"
    [ -d "$HOME" ] || fail "HOME is not a directory"
}

bundle_state_root() {
    bundle_user_home
    printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/ap/bundle"
}

bundle_config_file() {
    bundle_user_home
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/ap/bundle.conf"
}

bundle_chain_file() {
    printf '%s/%s/chain.conf\n' "$(bundle_state_root)" "$1"
}

bundle_config_get() {
    bundle_cfg=$(bundle_config_file)
    [ -f "$bundle_cfg" ] || return 0
    git config --file "$bundle_cfg" --get "$1" 2>/dev/null || true
}

bundle_append_line() {
    if [ -z "$1" ]; then
        printf '%s\n' "$2"
    else
        printf '%s\n%s\n' "$1" "$2"
    fi
}

bundle_line_in() {
    bundle_hay=$1
    bundle_needle=$2
    [ -n "$bundle_hay" ] || return 1
    while IFS= read -r bundle_line; do
        [ "$bundle_line" = "$bundle_needle" ] && return 0
    done <<EOF
$bundle_hay
EOF
    return 1
}

bundle_sorted_lines() {
    if [ -z "$1" ]; then
        printf ''
        return 0
    fi
    printf '%s\n' "$1" | sort
}

bundle_require_exportable_repo() {
    bundle_er=$1
    bundle_el=$2
    bundle_git_c "$bundle_er" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "$bundle_el is not a Git worktree"
    bundle_head=$(bundle_git_c "$bundle_er" rev-parse --verify HEAD^{commit} 2>/dev/null || true)
    [ -n "$bundle_head" ] || fail "$bundle_el HEAD does not resolve to a commit"
    bundle_shallow=$(bundle_git_c "$bundle_er" rev-parse --is-shallow-repository)
    [ "$bundle_shallow" = false ] || fail "$bundle_el is a shallow repository; refuse export"
    bundle_replace=$(bundle_git_c "$bundle_er" for-each-ref --format='%(refname)' refs/replace)
    [ -z "$bundle_replace" ] || fail "$bundle_el has refs/replace; refuse export"
    bundle_status=$(bundle_git_c "$bundle_er" status --porcelain=v1 --untracked-files=all)
    [ -z "$bundle_status" ] || fail "$bundle_el worktree or index is not clean"
    bundle_origin=$(bundle_git_c "$bundle_er" config --local --get remote.origin.url 2>/dev/null || true)
    [ -n "$bundle_origin" ] || fail "$bundle_el is missing remote.origin.url"
    bundle_refuse_lfs "$bundle_er" "$bundle_el"
    printf '%s\n' "$bundle_head"
}

bundle_refuse_lfs() {
    bundle_er=$1
    bundle_el=$2
    bundle_lfs_smudge=$(bundle_git_c "$bundle_er" config --local --get filter.lfs.smudge 2>/dev/null || true)
    bundle_lfs_process=$(bundle_git_c "$bundle_er" config --local --get filter.lfs.process 2>/dev/null || true)
    [ -z "$bundle_lfs_smudge" ] && [ -z "$bundle_lfs_process" ] || fail "$bundle_el has Git LFS configured; offline bundle transport does not include LFS objects"
    if bundle_git_c "$bundle_er" cat-file -e HEAD:.gitattributes 2>/dev/null; then
        bundle_ga=$(bundle_git_c "$bundle_er" show HEAD:.gitattributes)
        if printf '%s\n' "$bundle_ga" | grep 'filter=lfs' >/dev/null 2>&1; then
            fail "$bundle_el tracks Git LFS filters; refuse export"
        fi
    fi
}

bundle_path_is_risky() {
    bundle_pn=$1
    bundle_base=${bundle_pn##*/}
    case "$bundle_base" in
        .env.example)
            return 1
            ;;
        .env|.env.*)
            return 0
            ;;
        id_rsa|id_dsa|id_ecdsa|id_ed25519)
            return 0
            ;;
        *.pem|*.p12|*.pfx|*.key|*.keystore|*.jks)
            return 0
            ;;
        credentials.json|secrets.json|secrets.yaml)
            return 0
            ;;
        .netrc|.pypirc)
            return 0
            ;;
    esac
    return 1
}

bundle_scan_secrets() {
    bundle_sr=$1
    bundle_sl=$2
    bundle_srange=$3
    bundle_allow=$4
    bundle_hits=
    bundle_alloc_tmp
    bundle_raw=$bundle_tmp/objects
    if [ "$bundle_srange" = HEAD ]; then
        bundle_git_c "$bundle_sr" rev-list --objects HEAD > "$bundle_raw"
    else
        bundle_git_c "$bundle_sr" rev-list --objects "$bundle_srange" > "$bundle_raw"
    fi
    bundle_paths=$(awk 'NF >= 2 { $1=""; sub(/^ /, ""); print }' "$bundle_raw" | sed '/^$/d' | sort -u)
    if [ -n "$bundle_paths" ]; then
        while IFS= read -r bundle_pn; do
            [ -n "$bundle_pn" ] || continue
            if bundle_path_is_risky "$bundle_pn"; then
                if bundle_line_in "$bundle_allow" "$bundle_pn"; then
                    continue
                fi
                bundle_hits=$(bundle_append_line "$bundle_hits" "$bundle_pn")
            fi
        done <<EOF
$bundle_paths
EOF
    fi
    if [ -n "$bundle_hits" ]; then
        printf 'ap: ERROR: %s contains suspicious tracked or historical path(s); refuse export (filename scanning does not prove absence of secrets):\n' "$bundle_sl" >&2
        printf '%s\n' "$bundle_hits" >&2
        exit 1
    fi
}

bundle_list_gitlinks() {
    bundle_lr=$1
    bundle_out=
    bundle_tab=$(printf '\t')
    bundle_tree=$(bundle_git_c "$bundle_lr" ls-tree -r HEAD)
    if [ -n "$bundle_tree" ]; then
        while IFS= read -r bundle_line; do
            case "$bundle_line" in
                "160000 commit "*)
                    bundle_rest=${bundle_line#160000 commit }
                    bundle_gpath=${bundle_rest#*"$bundle_tab"}
                    bundle_gsha=${bundle_rest%%"$bundle_tab"*}
                    case "$bundle_gpath" in
                        *$'\n'*|*' '*)
                            fail "gitlink path must not contain whitespace: $bundle_gpath"
                            ;;
                    esac
                    bundle_out=$(bundle_append_line "$bundle_out" "$bundle_gsha $bundle_gpath")
                    ;;
            esac
        done <<EOF
$bundle_tree
EOF
    fi
    printf '%s\n' "$bundle_out"
}

bundle_branch_name() {
    bundle_br=$(bundle_git_c "$1" symbolic-ref -q --short HEAD 2>/dev/null || true)
    printf '%s\n' "$bundle_br"
}

bundle_create_named_bundle() {
    bundle_cr=$1
    bundle_cout=$2
    bundle_cmode=$3
    bundle_cbase=$4
    if [ "$bundle_cmode" = initial ]; then
        bundle_cbranch=$(bundle_branch_name "$bundle_cr")
        if [ -n "$bundle_cbranch" ]; then
            bundle_git_c "$bundle_cr" bundle create "$bundle_cout" HEAD "refs/heads/$bundle_cbranch" || fail "cannot create Git bundle from HEAD"
        else
            bundle_git_c "$bundle_cr" bundle create "$bundle_cout" HEAD || fail "cannot create Git bundle from HEAD"
        fi
    else
        bundle_git_c "$bundle_cr" merge-base --is-ancestor "$bundle_cbase" HEAD || fail "recorded initial commit is no longer an ancestor of HEAD; start a new chain with --initial --replace-chain"
        bundle_ctip=$(bundle_git_c "$bundle_cr" rev-parse HEAD)
        if [ "$bundle_ctip" = "$bundle_cbase" ]; then
            return 1
        fi
        bundle_git_c "$bundle_cr" bundle create "$bundle_cout" "$bundle_cbase..HEAD" || fail "cannot create incremental Git bundle"
    fi
    return 0
}

bundle_require_exporter() {
    require_tool_repository
    bundle_exporter_status=$(bundle_git_c "$ap_root" status --porcelain=v1 --untracked-files=all)
    [ -z "$bundle_exporter_status" ] || fail "exporter AP checkout is dirty"
    bundle_exporter_head=$(bundle_git_c "$ap_root" rev-parse --verify HEAD^{commit})
    bundle_exporter_blob=$(bundle_git_c "$ap_root" rev-parse HEAD:ap 2>/dev/null || true)
    [ -n "$bundle_exporter_blob" ] || fail "exporter AP HEAD does not contain ap"
    bundle_running_blob=$(bundle_git_c "$ap_root" hash-object -- "$ap_root/ap")
    [ "$bundle_running_blob" = "$bundle_exporter_blob" ] || fail "running ap does not match exporter HEAD:ap"
    bundle_git_c "$ap_root" cat-file -e "$bundle_exporter_head^{commit}" >/dev/null
    printf '%s\n' "$bundle_exporter_head"
}

bundle_is_canonical_ap_origin() {
    normalize_ap_url "$1" >/dev/null 2>&1
}

bundle_resolve_projects_root() {
    if [ -n "$bundle_opt_projects_root" ]; then
        bundle_require_abs_existing "$bundle_opt_projects_root" "--projects-root"
        return 0
    fi
    if [ -n "${AP_PROJECTS_ROOT:-}" ]; then
        bundle_require_abs_existing "$AP_PROJECTS_ROOT" "AP_PROJECTS_ROOT"
        return 0
    fi
    bundle_cfg_root=$(bundle_config_get bundle.projectsRoot)
    if [ -n "$bundle_cfg_root" ]; then
        bundle_require_abs_existing "$bundle_cfg_root" "bundle.projectsRoot"
        return 0
    fi
    bundle_user_home
    if [ -d "$HOME/Projects" ]; then
        physical_path "$HOME/Projects"
        return 0
    fi
    return 1
}

bundle_resolve_root() {
    if [ -n "$bundle_opt_root" ]; then
        bundle_require_abs_git_root "$bundle_opt_root" "--root"
        return 0
    fi
    if [ "$bundle_mode" != initial ] && [ -f "$bundle_chain_path" ]; then
        bundle_mapped=$(git config --file "$bundle_chain_path" --get chain.projectRoot 2>/dev/null || true)
        [ -n "$bundle_mapped" ] || fail "chain state is missing project root; provide --root or recreate with --initial --replace-chain"
        bundle_require_abs_git_root "$bundle_mapped" "stored chain project root"
        return 0
    fi
    if bundle_pr=$(bundle_resolve_projects_root); then
        bundle_candidate=$bundle_pr/$bundle_project
        if [ -d "$bundle_candidate" ]; then
            bundle_require_abs_git_root "$bundle_candidate" "resolved project root"
            return 0
        fi
    fi
    fail "cannot resolve project '$bundle_project'; provide --root <physical-git-root>"
}

bundle_resolve_output_dir() {
    if [ -n "$bundle_opt_output_dir" ]; then
        bundle_require_abs_existing "$bundle_opt_output_dir" "--output-dir"
        return 0
    fi
    bundle_cfg_out=$(bundle_config_get bundle.outputDir)
    if [ -n "$bundle_cfg_out" ]; then
        bundle_require_abs_existing "$bundle_cfg_out" "bundle.outputDir"
        return 0
    fi
    if [ -n "${XDG_DOWNLOAD_DIR:-}" ] && [ -d "$XDG_DOWNLOAD_DIR" ]; then
        bundle_require_abs_existing "$XDG_DOWNLOAD_DIR" "XDG_DOWNLOAD_DIR"
        return 0
    fi
    bundle_user_home
    if [ -d "$HOME/Downloads" ]; then
        physical_path "$HOME/Downloads"
        return 0
    fi
    bundle_pkg=$(bundle_state_root)/packages
    mkdir -p "$bundle_pkg" || fail "cannot create package directory $bundle_pkg"
    physical_path "$bundle_pkg"
}

bundle_load_chain() {
    [ -f "$bundle_chain_path" ] || fail "no bundle chain for '$bundle_project'; run ap bundle $bundle_project --initial first"
    bundle_chain_name=$(git config --file "$bundle_chain_path" --get chain.projectName 2>/dev/null || true)
    [ "$bundle_chain_name" = "$bundle_project" ] || fail "chain project name mismatch"
    bundle_chain_origin=$(git config --file "$bundle_chain_path" --get chain.originIdentity 2>/dev/null || true)
    bundle_chain_initial=$(git config --file "$bundle_chain_path" --get chain.initialCommit 2>/dev/null || true)
    bundle_chain_initial_ap=$(git config --file "$bundle_chain_path" --get chain.initialApCommit 2>/dev/null || true)
    bundle_chain_canonical=$(git config --file "$bundle_chain_path" --get chain.canonicalAp 2>/dev/null || true)
    bundle_chain_companion_root=$(git config --file "$bundle_chain_path" --get chain.companionRoot 2>/dev/null || true)
    bundle_chain_companion_initial=$(git config --file "$bundle_chain_path" --get chain.companionInitialCommit 2>/dev/null || true)
    bundle_chain_companion_identity=$(git config --file "$bundle_chain_path" --get chain.companionIdentity 2>/dev/null || true)
    bundle_chain_includes=
    bundle_inc_vals=$(git config --file "$bundle_chain_path" --get-all chain.includeSubmodule 2>/dev/null || true)
    bundle_chain_includes=$bundle_inc_vals
    [ -n "$bundle_chain_origin" ] || fail "chain state is missing origin identity"
    [ -n "$bundle_chain_initial" ] || fail "chain state is missing initial commit"
}

bundle_save_chain() {
    bundle_chain_dir=${bundle_chain_path%/*}
    mkdir -p "$bundle_chain_dir" || fail "cannot create chain state directory"
    bundle_chain_tmp=$bundle_chain_dir/chain.conf.tmp
    : > "$bundle_chain_tmp"
    git config --file "$bundle_chain_tmp" chain.schemaVersion 1
    git config --file "$bundle_chain_tmp" chain.projectName "$bundle_project"
    git config --file "$bundle_chain_tmp" chain.projectRoot "$bundle_root"
    git config --file "$bundle_chain_tmp" chain.originUrl "$bundle_origin_url"
    git config --file "$bundle_chain_tmp" chain.originIdentity "$bundle_origin_id"
    git config --file "$bundle_chain_tmp" chain.initialCommit "$bundle_head"
    git config --file "$bundle_chain_tmp" chain.canonicalAp "$bundle_canonical_ap"
    git config --file "$bundle_chain_tmp" chain.initialApCommit "$bundle_ap_head"
    git config --file "$bundle_chain_tmp" chain.createdAt "$bundle_created"
    git config --file "$bundle_chain_tmp" chain.exporterApCommit "$bundle_exporter_head"
    if [ -n "$bundle_companion_root" ]; then
        git config --file "$bundle_chain_tmp" chain.companionRoot "$bundle_companion_root"
        git config --file "$bundle_chain_tmp" chain.companionOriginUrl "$bundle_companion_origin"
        git config --file "$bundle_chain_tmp" chain.companionIdentity "$bundle_companion_id"
        git config --file "$bundle_chain_tmp" chain.companionInitialCommit "$bundle_companion_head"
    fi
    if [ -n "$bundle_includes" ]; then
        while IFS= read -r bundle_inc; do
            [ -n "$bundle_inc" ] || continue
            git config --file "$bundle_chain_tmp" --add chain.includeSubmodule "$bundle_inc"
        done <<EOF
$bundle_includes
EOF
    fi
    if [ -n "${bundle_sub_initials:-}" ]; then
        while IFS= read -r bundle_si; do
            [ -n "$bundle_si" ] || continue
            bundle_si_safe=${bundle_si%% *}
            bundle_si_rest=${bundle_si#* }
            bundle_si_path=${bundle_si_rest% *}
            bundle_si_sha=${bundle_si_rest##* }
            git config --file "$bundle_chain_tmp" "chain.submodule.$bundle_si_safe.path" "$bundle_si_path"
            git config --file "$bundle_chain_tmp" "chain.submodule.$bundle_si_safe.initialCommit" "$bundle_si_sha"
        done <<EOF
$bundle_sub_initials
EOF
    fi
    mv "$bundle_chain_tmp" "$bundle_chain_path"
}

bundle_verify_consumer_ap() {
    bundle_ap_path=$bundle_root/$SUBMODULE_PATH
    [ -d "$bundle_ap_path" ] || fail "project is missing .ap; initialize AP before export"
    bundle_ap_path=$(physical_path "$bundle_ap_path") || fail "cannot resolve .ap path"
    bundle_ap_git=$(bundle_git_c "$bundle_ap_path" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$bundle_ap_git" ] || fail ".ap is not a Git worktree"
    bundle_ap_git=$(physical_path "$bundle_ap_git") || fail "cannot resolve .ap Git root"
    [ "$bundle_ap_git" = "$bundle_ap_path" ] || fail ".ap must be the Git worktree top level"
    bundle_ap_entry=$(bundle_git_c "$bundle_root" ls-files -s -- "$SUBMODULE_PATH" 2>/dev/null || true)
    [ -n "$bundle_ap_entry" ] || fail ".ap is not recorded in the project index"
    bundle_ap_mode=$(printf '%s\n' "$bundle_ap_entry" | awk '{print $1}')
    bundle_ap_gitlink=$(printf '%s\n' "$bundle_ap_entry" | awk '{print $2}')
    [ "$bundle_ap_mode" = 160000 ] || fail ".ap is not recorded as a submodule gitlink"
    bundle_ap_head=$(bundle_require_exportable_repo "$bundle_ap_path" ".ap")
    [ "$bundle_ap_head" = "$bundle_ap_gitlink" ] || fail ".ap HEAD $bundle_ap_head does not match superproject gitlink $bundle_ap_gitlink"
    bundle_ap_origin=$(bundle_git_c "$bundle_ap_path" config --local --get remote.origin.url 2>/dev/null || true)
    bundle_is_canonical_ap_origin "$bundle_ap_origin" || fail ".ap origin remote is not canonical AP"
    [ -f "$bundle_root/.gitmodules" ] || fail ".gitmodules is missing"
    bundle_gm_matches=$(bundle_git_c "$bundle_root" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '$2 == ".ap" { print $1 }' || true)
    bundle_gm_count=$(printf '%s\n' "$bundle_gm_matches" | sed '/^$/d' | wc -l | tr -d ' ')
    [ "$bundle_gm_count" = 1 ] || fail ".gitmodules must contain exactly one submodule path .ap"
    bundle_gm_key=$(printf '%s\n' "$bundle_gm_matches" | sed -n '1p')
    bundle_gm_section=${bundle_gm_key#submodule.}
    bundle_gm_section=${bundle_gm_section%.path}
    bundle_gm_url=$(bundle_git_c "$bundle_root" config -f .gitmodules --get "submodule.$bundle_gm_section.url" 2>/dev/null || true)
    bundle_is_canonical_ap_origin "$bundle_gm_url" || fail ".gitmodules URL for .ap is not canonical AP"
}

bundle_handle_other_submodules() {
    bundle_gl=$(bundle_list_gitlinks "$bundle_root")
    bundle_unexpected=
    bundle_needed=$bundle_includes
    if [ -n "$bundle_gl" ]; then
        while IFS= read -r bundle_gline; do
            [ -n "$bundle_gline" ] || continue
            bundle_gsha=${bundle_gline%% *}
            bundle_gpath=${bundle_gline#* }
            if [ "$bundle_gpath" = "$SUBMODULE_PATH" ] && [ "$bundle_canonical_ap" = no ]; then
                continue
            fi
            if bundle_line_in "$bundle_needed" "$bundle_gpath"; then
                continue
            fi
            bundle_unexpected=$(bundle_append_line "$bundle_unexpected" "$bundle_gpath")
        done <<EOF
$bundle_gl
EOF
    fi
    if [ -n "$bundle_unexpected" ]; then
        printf 'ap: ERROR: project contains submodule gitlink(s) not included in this export:\n' >&2
        printf '%s\n' "$bundle_unexpected" >&2
        printf 'ap: ERROR: include each required path with --include-submodule or omit unsupported gitlinks\n' >&2
        exit 1
    fi
    if [ -n "$bundle_includes" ]; then
        while IFS= read -r bundle_inc; do
            [ -n "$bundle_inc" ] || continue
            bundle_found=no
            while IFS= read -r bundle_gline; do
                [ -n "$bundle_gline" ] || continue
                bundle_gpath=${bundle_gline#* }
                if [ "$bundle_gpath" = "$bundle_inc" ]; then
                    bundle_found=yes
                    break
                fi
            done <<EOF
$bundle_gl
EOF
            [ "$bundle_found" = yes ] || fail "--include-submodule $bundle_inc is not a HEAD gitlink"
        done <<EOF
$bundle_includes
EOF
    fi
}

bundle_export_included_submodules() {
    bundle_sub_changed=no
    bundle_sub_files=
    bundle_sub_heads=
    bundle_sub_initials=
    [ -n "$bundle_includes" ] || return 0
    bundle_gl=$(bundle_list_gitlinks "$bundle_root")
    while IFS= read -r bundle_inc; do
        [ -n "$bundle_inc" ] || continue
        bundle_gsha=
        while IFS= read -r bundle_gline; do
            [ -n "$bundle_gline" ] || continue
            bundle_gpath=${bundle_gline#* }
            if [ "$bundle_gpath" = "$bundle_inc" ]; then
                bundle_gsha=${bundle_gline%% *}
                break
            fi
        done <<EOF
$bundle_gl
EOF
        [ -n "$bundle_gsha" ] || fail "internal error: missing gitlink for $bundle_inc"
        bundle_sub_root=$bundle_root/$bundle_inc
        [ -d "$bundle_sub_root" ] || fail "included submodule $bundle_inc is not checked out locally"
        bundle_sub_root=$(physical_path "$bundle_sub_root") || fail "cannot resolve included submodule $bundle_inc"
        bundle_sub_head=$(bundle_require_exportable_repo "$bundle_sub_root" "submodule $bundle_inc")
        [ "$bundle_sub_head" = "$bundle_gsha" ] || fail "submodule $bundle_inc HEAD $bundle_sub_head does not match gitlink $bundle_gsha"
        bundle_scan_secrets "$bundle_sub_root" "submodule $bundle_inc" HEAD "$bundle_allows"
        bundle_safe=$(printf '%s\n' "$bundle_inc" | sed 's/\//--/g')
        bundle_sub_file=submodule-$bundle_safe.bundle
        if bundle_line_in "$bundle_sub_files" "$bundle_sub_file"; then
            fail "included submodule filename collision for $bundle_inc"
        fi
        bundle_sub_base=
        if [ "$bundle_mode" = incremental ]; then
            bundle_sub_base=$(git config --file "$bundle_chain_path" --get "chain.submodule.$bundle_safe.initialCommit" 2>/dev/null || true)
            [ -n "$bundle_sub_base" ] || fail "chain state is missing initial commit for submodule $bundle_inc; recreate with --initial --replace-chain"
            if [ "$bundle_sub_head" = "$bundle_sub_base" ]; then
                git config --file "$bundle_manifest" "submodule.$bundle_safe.status" omitted-unchanged-from-initial
                git config --file "$bundle_manifest" "submodule.$bundle_safe.path" "$bundle_inc"
                git config --file "$bundle_manifest" "submodule.$bundle_safe.head" "$bundle_sub_head"
                continue
            fi
            bundle_scan_secrets "$bundle_sub_root" "submodule $bundle_inc" "$bundle_sub_base..HEAD" "$bundle_allows"
            bundle_create_named_bundle "$bundle_sub_root" "$bundle_payload/$bundle_sub_file" incremental "$bundle_sub_base" || fail "submodule $bundle_inc incremental bundle is empty despite HEAD change"
        else
            bundle_create_named_bundle "$bundle_sub_root" "$bundle_payload/$bundle_sub_file" initial ""
        fi
        bundle_sub_changed=yes
        bundle_sub_files=$(bundle_append_line "$bundle_sub_files" "$bundle_sub_file")
        bundle_sub_heads=$(bundle_append_line "$bundle_sub_heads" "$bundle_inc $bundle_sub_head $bundle_sub_file")
        if [ "$bundle_mode" = initial ]; then
            bundle_sub_initials=$(bundle_append_line "$bundle_sub_initials" "$bundle_safe $bundle_inc $bundle_sub_head")
        fi
        git config --file "$bundle_manifest" "submodule.$bundle_safe.path" "$bundle_inc"
        git config --file "$bundle_manifest" "submodule.$bundle_safe.head" "$bundle_sub_head"
        git config --file "$bundle_manifest" "submodule.$bundle_safe.bundle" "$bundle_sub_file"
        git config --file "$bundle_manifest" "submodule.$bundle_safe.status" included
    done <<EOF
$bundle_includes
EOF
}

bundle_write_import_md() {
    bundle_imp=$1
    bundle_kind_word=$2
    cat > "$bundle_imp" <<EOF
# ChatOrchestrator offline Git transport — reconstruction

This ZIP is an attachment container around Git-native bundles. It is **exact
committed bundle evidence**. It is not independently observed current public
branch evidence.

Mandatory limitation:

    public branch state not directly observed

Never promote this package into a public-ref, publication-equality, push, or
remote-synchronization claim. A later Worker or full Orchestrator with GitHub
access still runs the normal public gate before any mutation or push that
requires it.

Do **not** recover a missing inspection checkout through GitHub, a mirror, a
proxy, DNS pinning, a guessed cache, or conversational memory. Ask the
Cooperator for a new:

    ap bundle $bundle_project --initial

Filename scanning during export does not prove absence of secrets. Do not
treat this package as secret-free.

## Extract

    python3 -c "import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" PACKAGE.zip DEST

Verify \`checksums\` after extraction. Each line is:

    sha256  <hex>  <filename>

Filenames in this package do not contain spaces. Reconstruct only after hashes
match.

## Bundle verification

Incremental packages must be verified inside the already reconstructed repository
so Git can check prerequisite objects:

    git -C PROJECT bundle verify ABS/project.bundle

Some Git versions can also verify an initial bundle outside a repository.
A throwaway verification repository always works:

    git init --bare VERIFY
    git -C VERIFY bundle verify ABS/project.bundle
    git clone ABS/project.bundle PROJECT

Do not treat a successful object-hash check as public branch evidence.

### Initial package

Then reconstruct \`.ap\` from \`ap.bundle\` when present (never \`git submodule update\`
from the network):

    git clone ABS/ap.bundle PROJECT/.ap

Confirm \`git -C PROJECT rev-parse HEAD:.ap\` equals \`git -C PROJECT/.ap rev-parse HEAD\`.
Clone any included submodule bundles into their project-relative paths the same
way. Set \`remote.origin.url\` to the identity URLs recorded in \`manifest.conf\`
**without fetching**.

### Incremental package

The inspection checkout from the same chain initial must still exist. Verify
prerequisites in that repository, then fetch from the local bundle file:

    git -C PROJECT bundle verify ABS/project.bundle
    git -C PROJECT fetch --no-recurse-submodules ABS/project.bundle
    git -C PROJECT checkout --detach <bundle.head from manifest.conf>

Repeat for \`.ap\`, companion, and included submodules when those payloads are
present. If verify reports missing prerequisites or the checkout is gone,
request a new \`--initial\` package. Do not contact GitHub.

## This package

- project: $bundle_project
- packageKind: $bundle_kind_word
- project HEAD: $bundle_head
- AP gitlink/HEAD: $bundle_ap_head
- exporter AP commit: $bundle_exporter_head
- createdAt: $bundle_created
- evidenceClass: exact-committed-bundle-evidence
- publicVerification: not-performed
- publicBranchState: not-directly-observed

Inspection checkouts are ephemeral cache, not durable project storage.
EOF
}

cmd_bundle() {
    trap 'bundle_cleanup' EXIT
    trap 'bundle_cleanup; exit 129' HUP
    trap 'bundle_cleanup; exit 130' INT
    trap 'bundle_cleanup; exit 143' TERM
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
        [ "$#" -eq 1 ] || fail "bundle --help takes no extra arguments"
        bundle_usage
        return 0
    fi

    [ "$#" -ge 1 ] || fail "bundle requires a project name; see ap bundle --help"
    bundle_project=$1
    shift
    bundle_valid_project_name "$bundle_project"

    bundle_mode=incremental
    bundle_opt_root=
    bundle_opt_projects_root=
    bundle_opt_companion=
    bundle_opt_output_dir=
    bundle_opt_replace=no
    bundle_includes=
    bundle_allows=

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --initial)
                bundle_mode=initial
                shift
                ;;
            --replace-chain)
                bundle_opt_replace=yes
                shift
                ;;
            --root)
                [ "$#" -ge 2 ] || fail "--root requires a value"
                bundle_opt_root=$2
                shift 2
                ;;
            --projects-root)
                [ "$#" -ge 2 ] || fail "--projects-root requires a value"
                bundle_opt_projects_root=$2
                shift 2
                ;;
            --companion-trace)
                [ "$#" -ge 2 ] || fail "--companion-trace requires a value"
                bundle_opt_companion=$2
                shift 2
                ;;
            --include-submodule)
                [ "$#" -ge 2 ] || fail "--include-submodule requires a value"
                bundle_require_relpath "$2" "--include-submodule"
                if bundle_line_in "$bundle_includes" "$2"; then
                    fail "duplicate --include-submodule $2"
                fi
                bundle_includes=$(bundle_append_line "$bundle_includes" "$2")
                shift 2
                ;;
            --allow-path)
                [ "$#" -ge 2 ] || fail "--allow-path requires a value"
                bundle_require_relpath "$2" "--allow-path"
                if bundle_line_in "$bundle_allows" "$2"; then
                    fail "duplicate --allow-path $2"
                fi
                bundle_allows=$(bundle_append_line "$bundle_allows" "$2")
                shift 2
                ;;
            --output-dir)
                [ "$#" -ge 2 ] || fail "--output-dir requires a value"
                bundle_opt_output_dir=$2
                shift 2
                ;;
            --help|-h)
                fail "place --help immediately after bundle"
                ;;
            *)
                fail "unknown bundle option: $1"
                ;;
        esac
    done

    if [ "$bundle_mode" != initial ]; then
        [ -z "$bundle_opt_projects_root" ] || fail "--projects-root is only valid with --initial"
        [ -z "$bundle_opt_companion" ] || fail "--companion-trace is only valid with --initial; recreate the chain to change it"
        [ "$bundle_opt_replace" = no ] || fail "--replace-chain requires --initial"
    fi

    bundle_exporter_head=$(bundle_require_exporter)
    bundle_chain_path=$(bundle_chain_file "$bundle_project")

    if [ "$bundle_mode" = initial ]; then
        if [ -f "$bundle_chain_path" ] && [ "$bundle_opt_replace" != yes ]; then
            fail "bundle chain already exists for '$bundle_project'; pass --replace-chain to start a new initial package"
        fi
    else
        bundle_load_chain
        if [ -n "$bundle_includes" ]; then
            [ "$(bundle_sorted_lines "$bundle_includes")" = "$(bundle_sorted_lines "$bundle_chain_includes")" ] || fail "--include-submodule must match the stored chain; recreate with --initial --replace-chain to change it"
        else
            bundle_includes=$bundle_chain_includes
        fi
        if [ -n "$bundle_chain_companion_root" ]; then
            bundle_opt_companion=$bundle_chain_companion_root
        fi
    fi

    bundle_root=$(bundle_resolve_root)
    bundle_head=$(bundle_require_exportable_repo "$bundle_root" "project")
    bundle_origin_url=$(bundle_git_c "$bundle_root" config --local --get remote.origin.url)
    bundle_origin_id=$(bundle_origin_identity "$bundle_origin_url")
    [ -n "$bundle_origin_id" ] || fail "cannot derive origin identity from $bundle_origin_url"

    if bundle_is_canonical_ap_origin "$bundle_origin_url"; then
        bundle_canonical_ap=yes
        bundle_ap_head=not-applicable
        bundle_ap_path=
        [ -z "$bundle_includes" ] || fail "canonical AP self-bundle does not take --include-submodule"
    else
        bundle_canonical_ap=no
        bundle_verify_consumer_ap
    fi

    if [ "$bundle_mode" = incremental ]; then
        [ "$bundle_origin_id" = "$bundle_chain_origin" ] || fail "project origin identity changed; recorded $bundle_chain_origin observed $bundle_origin_id"
        [ "$bundle_canonical_ap" = "$bundle_chain_canonical" ] || fail "project canonical-AP classification does not match the stored chain"
        bundle_mapped_root=$(git config --file "$bundle_chain_path" --get chain.projectRoot)
        [ "$bundle_root" = "$bundle_mapped_root" ] || fail "project root $bundle_root does not match stored chain root $bundle_mapped_root"
        bundle_git_c "$bundle_root" merge-base --is-ancestor "$bundle_chain_initial" HEAD || fail "recorded initial commit is no longer an ancestor of project HEAD; start a new chain with --initial --replace-chain"
        if [ "$bundle_canonical_ap" = no ]; then
            bundle_git_c "$bundle_ap_path" merge-base --is-ancestor "$bundle_chain_initial_ap" HEAD || fail "recorded initial .ap commit is no longer an ancestor of .ap HEAD; start a new chain with --initial --replace-chain"
        fi
    fi

    bundle_scan_range=HEAD
    if [ "$bundle_mode" = incremental ]; then
        bundle_scan_range=$bundle_chain_initial..HEAD
    fi
    bundle_scan_secrets "$bundle_root" project "$bundle_scan_range" "$bundle_allows"
    if [ "$bundle_canonical_ap" = no ]; then
        bundle_ap_scan=HEAD
        if [ "$bundle_mode" = incremental ] && [ "$bundle_ap_head" != "$bundle_chain_initial_ap" ]; then
            bundle_ap_scan=$bundle_chain_initial_ap..HEAD
        fi
        bundle_scan_secrets "$bundle_ap_path" ".ap" "$bundle_ap_scan" "$bundle_allows"
    fi

    bundle_handle_other_submodules

    bundle_companion_root=
    bundle_companion_head=
    bundle_companion_origin=
    bundle_companion_id=
    if [ -n "$bundle_opt_companion" ]; then
        bundle_companion_root=$(bundle_require_abs_git_root "$bundle_opt_companion" "--companion-trace")
        bundle_companion_head=$(bundle_require_exportable_repo "$bundle_companion_root" "companion trace")
        bundle_companion_origin=$(bundle_git_c "$bundle_companion_root" config --local --get remote.origin.url)
        bundle_companion_id=$(bundle_origin_identity "$bundle_companion_origin")
        [ -n "$bundle_companion_id" ] || fail "cannot derive companion origin identity"
        bundle_cscan=HEAD
        if [ "$bundle_mode" = incremental ]; then
            [ "$bundle_companion_id" = "$bundle_chain_companion_identity" ] || fail "companion identity changed; recreate the chain"
            bundle_git_c "$bundle_companion_root" merge-base --is-ancestor "$bundle_chain_companion_initial" HEAD || fail "recorded companion initial commit is no longer an ancestor of companion HEAD; start a new chain with --initial --replace-chain"
            bundle_cscan=$bundle_chain_companion_initial..HEAD
        fi
        bundle_scan_secrets "$bundle_companion_root" "companion trace" "$bundle_cscan" "$bundle_allows"
    fi

    bundle_alloc_tmp
    bundle_payload=$bundle_tmp/payload
    mkdir -p "$bundle_payload"
    bundle_manifest=$bundle_payload/manifest.conf
    : > "$bundle_manifest"
    bundle_sub_changed=no
    bundle_sub_files=
    bundle_sub_heads=
    bundle_sub_initials=
    bundle_created=$(date -u +%Y%m%dT%H%M%SZ)
    bundle_changed=no
    bundle_project_file=
    bundle_ap_file=
    bundle_companion_file=

    if [ "$bundle_mode" = initial ]; then
        bundle_chain_write=$(dirname "$bundle_chain_path")/chain.conf.tmp
        mkdir -p "$(dirname "$bundle_chain_path")"
        : > "$bundle_chain_write"
        bundle_create_named_bundle "$bundle_root" "$bundle_payload/project.bundle" initial ""
        bundle_project_file=project.bundle
        bundle_changed=yes
        if [ "$bundle_canonical_ap" = no ]; then
            bundle_create_named_bundle "$bundle_ap_path" "$bundle_payload/ap.bundle" initial ""
            bundle_ap_file=ap.bundle
        fi
        if [ -n "$bundle_companion_root" ]; then
            bundle_create_named_bundle "$bundle_companion_root" "$bundle_payload/companion-trace.bundle" initial ""
            bundle_companion_file=companion-trace.bundle
        fi
        bundle_export_included_submodules
    else
        bundle_chain_write=$bundle_chain_path
        if bundle_create_named_bundle "$bundle_root" "$bundle_payload/project.bundle" incremental "$bundle_chain_initial"; then
            bundle_project_file=project.bundle
            bundle_changed=yes
        fi
        if [ "$bundle_canonical_ap" = no ] && [ "$bundle_ap_head" != "$bundle_chain_initial_ap" ]; then
            bundle_create_named_bundle "$bundle_ap_path" "$bundle_payload/ap.bundle" incremental "$bundle_chain_initial_ap" || fail ".ap incremental bundle is empty despite gitlink change"
            bundle_ap_file=ap.bundle
            bundle_changed=yes
        fi
        if [ -n "$bundle_companion_root" ] && [ "$bundle_companion_head" != "$bundle_chain_companion_initial" ]; then
            bundle_create_named_bundle "$bundle_companion_root" "$bundle_payload/companion-trace.bundle" incremental "$bundle_chain_companion_initial" || fail "companion incremental bundle is empty despite HEAD change"
            bundle_companion_file=companion-trace.bundle
            bundle_changed=yes
        fi
        bundle_export_included_submodules
        if [ "$bundle_sub_changed" = yes ]; then
            bundle_changed=yes
        fi
        [ "$bundle_changed" = yes ] || fail "nothing new to export since the initial package"
    fi

    bundle_branch=$(bundle_branch_name "$bundle_root")
    if [ -n "$bundle_branch" ]; then
        bundle_branch_record=$bundle_branch
        bundle_detached=no
    else
        bundle_branch_record=detached
        bundle_detached=yes
    fi

    bundle_kind=update
    bundle_kind_word=incremental
    if [ "$bundle_mode" = initial ]; then
        bundle_kind=initial
        bundle_kind_word=initial
    fi

    git config --file "$bundle_manifest" bundle.schemaVersion 1
    git config --file "$bundle_manifest" bundle.transportKind chat-orchestrator-offline-git
    git config --file "$bundle_manifest" bundle.packageKind "$bundle_kind_word"
    git config --file "$bundle_manifest" bundle.projectName "$bundle_project"
    git config --file "$bundle_manifest" bundle.originUrl "$bundle_origin_url"
    git config --file "$bundle_manifest" bundle.originIdentity "$bundle_origin_id"
    git config --file "$bundle_manifest" bundle.head "$bundle_head"
    if [ "$bundle_mode" = initial ]; then
        git config --file "$bundle_manifest" bundle.initialCommit "$bundle_head"
    else
        git config --file "$bundle_manifest" bundle.initialCommit "$bundle_chain_initial"
    fi
    git config --file "$bundle_manifest" bundle.branch "$bundle_branch_record"
    git config --file "$bundle_manifest" bundle.detached "$bundle_detached"
    git config --file "$bundle_manifest" bundle.apGitlink "$bundle_ap_head"
    git config --file "$bundle_manifest" bundle.exporterApCommit "$bundle_exporter_head"
    git config --file "$bundle_manifest" bundle.createdAt "$bundle_created"
    git config --file "$bundle_manifest" bundle.publicVerification not-performed
    git config --file "$bundle_manifest" bundle.evidenceClass exact-committed-bundle-evidence
    git config --file "$bundle_manifest" bundle.publicBranchState not-directly-observed
    git config --file "$bundle_manifest" bundle.hashAlgorithm sha256
    if [ -n "$bundle_project_file" ]; then
        git config --file "$bundle_manifest" bundle.projectBundle "$bundle_project_file"
    else
        git config --file "$bundle_manifest" bundle.projectBundle omitted-unchanged-from-initial
    fi
    if [ "$bundle_canonical_ap" = yes ]; then
        git config --file "$bundle_manifest" bundle.apBundle not-applicable
    elif [ -n "$bundle_ap_file" ]; then
        git config --file "$bundle_manifest" bundle.apBundle "$bundle_ap_file"
    else
        git config --file "$bundle_manifest" bundle.apBundle omitted-unchanged-from-initial
    fi
    if [ -n "$bundle_companion_file" ]; then
        git config --file "$bundle_manifest" bundle.companionBundle "$bundle_companion_file"
        git config --file "$bundle_manifest" bundle.companionIdentity "$bundle_companion_id"
        git config --file "$bundle_manifest" bundle.companionHead "$bundle_companion_head"
        git config --file "$bundle_manifest" bundle.companionOriginUrl "$bundle_companion_origin"
    elif [ -n "$bundle_companion_root" ]; then
        git config --file "$bundle_manifest" bundle.companionBundle omitted-unchanged-from-initial
        git config --file "$bundle_manifest" bundle.companionIdentity "$bundle_companion_id"
        git config --file "$bundle_manifest" bundle.companionHead "$bundle_companion_head"
    else
        git config --file "$bundle_manifest" bundle.companionBundle not-configured
    fi
    if [ -n "$bundle_allows" ]; then
        while IFS= read -r bundle_allow_one; do
            [ -n "$bundle_allow_one" ] || continue
            git config --file "$bundle_manifest" --add bundle.allowPath "$bundle_allow_one"
        done <<EOF
$bundle_allows
EOF
    fi

    bundle_write_import_md "$bundle_payload/IMPORT.md" "$bundle_kind_word"

    bundle_checksums=$bundle_payload/checksums
    : > "$bundle_checksums"
    printf '# algorithm=sha256 format=sha256<two-spaces><hex><two-spaces><filename>\n' > "$bundle_checksums"
    bundle_payload_names=
    for bundle_fn in project.bundle ap.bundle companion-trace.bundle IMPORT.md; do
        if [ -f "$bundle_payload/$bundle_fn" ]; then
            bundle_payload_names=$(bundle_append_line "$bundle_payload_names" "$bundle_fn")
        fi
    done
    if [ -n "${bundle_sub_files:-}" ]; then
        while IFS= read -r bundle_sf; do
            [ -n "$bundle_sf" ] || continue
            bundle_payload_names=$(bundle_append_line "$bundle_payload_names" "$bundle_sf")
        done <<EOF
$bundle_sub_files
EOF
    fi
    if [ -n "$bundle_payload_names" ]; then
        while IFS= read -r bundle_fn; do
            [ -n "$bundle_fn" ] || continue
            bundle_hx=$(bundle_sha256 "$bundle_payload/$bundle_fn")
            bundle_hash_key=$(printf '%s\n' "$bundle_fn" | sed 's/[^A-Za-z0-9]/-/g')
            git config --file "$bundle_manifest" "bundle.hash-$bundle_hash_key" "$bundle_hx"
        done <<EOF
$bundle_payload_names
EOF
    fi
    bundle_payload_names=$(bundle_append_line "$bundle_payload_names" manifest.conf)
    while IFS= read -r bundle_fn; do
        [ -n "$bundle_fn" ] || continue
        bundle_hx=$(bundle_sha256 "$bundle_payload/$bundle_fn")
        printf 'sha256  %s  %s\n' "$bundle_hx" "$bundle_fn" >> "$bundle_checksums"
    done <<EOF
$bundle_payload_names
EOF

    bundle_out_dir=$(bundle_resolve_output_dir)
    bundle_head12=$(printf '%s\n' "$bundle_head" | cut -c1-12)
    bundle_zip_name=$bundle_project-ap-transport-$bundle_kind-$bundle_created-$bundle_head12.zip
    bundle_zip_path=$bundle_out_dir/$bundle_zip_name
    [ ! -e "$bundle_zip_path" ] || fail "refusing to overwrite existing package: $bundle_zip_path"

    bundle_alloc_tmp
    bundle_zip_repo=$bundle_tmp/zipgit
    mkdir -p "$bundle_zip_repo"
    (
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
        git -c init.defaultBranch=ap-transport init -q "$bundle_zip_repo"
    )
    bundle_copy_names=$bundle_payload_names
    bundle_copy_names=$(bundle_append_line "$bundle_copy_names" checksums)
    while IFS= read -r bundle_fn; do
        [ -n "$bundle_fn" ] || continue
        cp -f "$bundle_payload/$bundle_fn" "$bundle_zip_repo/$bundle_fn"
    done <<EOF
$bundle_copy_names
EOF
    printf '* binary\n' > "$bundle_zip_repo/.gitattributes"
    (
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
        git -C "$bundle_zip_repo" -c core.hooksPath=/dev/null -c core.autocrlf=false add -A
        git -C "$bundle_zip_repo" -c core.hooksPath=/dev/null \
            -c user.name=ap -c user.email=ap@offline-bundle \
            commit -q -m "ap-transport"
        set --
        while IFS= read -r bundle_fn; do
            [ -n "$bundle_fn" ] || continue
            set -- "$@" "$bundle_fn"
        done <<EOF
$bundle_copy_names
EOF
        git -C "$bundle_zip_repo" archive --format=zip -o "$bundle_zip_path" HEAD -- "$@"
    ) || fail "cannot create transport ZIP with git archive"

    if [ "$bundle_mode" = initial ]; then
        bundle_save_chain
        rm -f "$bundle_chain_write"
    fi

    say "OK transport kind: chat-orchestrator-offline-git"
    say "OK package kind: $bundle_kind_word"
    say "OK project: $bundle_project"
    say "OK project HEAD: $bundle_head"
    say "OK evidence class: exact-committed-bundle-evidence"
    say "OK public branch state not directly observed"
    say "READY: $bundle_zip_path"
}

project_stage_argument=no
if [ "${1:-}" = --ap-internal-sanitized-stage ]; then
    project_stage_argument=yes
    shift
fi

case "${1:-help}" in
    init)
        [ "$#" -eq 1 ] || fail "init takes no arguments"
        cmd_init
        ;;
    doctor)
        if [ "$#" -eq 1 ]; then
            cmd_doctor strict
        elif [ "$#" -eq 2 ] && [ "$2" = "--candidate" ]; then
            cmd_doctor candidate
        else
            fail "doctor takes no argument or --candidate"
        fi
        ;;
    project)
        project_clean_stage "$project_stage_argument" "$@"
        shift
        cmd_project "$@"
        ;;
    exec)
        project_clean_stage "$project_stage_argument" "$@"
        shift
        cmd_exec "$@"
        ;;
    update)
        [ "$#" -eq 2 ] || fail "update requires --check or --apply"
        case "$2" in
            --check) cmd_update_check ;;
            --apply) cmd_update_apply ;;
            *) fail "unknown update option: $2" ;;
        esac
        ;;
    bundle)
        shift
        cmd_bundle "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
