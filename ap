#!/bin/sh
set -eu

CANONICAL_URL="https://github.com/cisarik/ap.git"
SUBMODULE_PATH=".ap"
BEGIN_MARKER="<!-- BEGIN MANAGED AP INTEGRATION -->"
END_MARKER="<!-- END MANAGED AP INTEGRATION -->"

say() {
    printf '%s\n' "$*"
}

fail() {
    printf 'ap: ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage:
  ap init
  ap doctor [--candidate]
  ap project check --root <physical-root> --baseline <commit>
  ap project check --root <physical-root> --candidate
  ap exec --root <physical-root> --baseline <commit> --operation <id> -- <argv>
  ap update --check
  ap update --apply
  ap help

Commands:
  init                Create or refresh the managed AP block in the superproject AGENTS.md.
  doctor              Strict read-only health check for the committed .ap pin.
  doctor --candidate  Read-only health check for an intentional .ap update or rollback candidate.
  project check       Validate a baseline contract and CPython, or a non-authorizing candidate.
  exec                Run one baseline-declared operation in a sanitized direct-exec envelope.
  update --check      Check whether canonical AP main is a forward update.
  update --apply      Fetch canonical AP main and move only the .ap checkout to that commit.

Integration commands run from an initialized .ap Git submodule, normally as
./.ap/ap. Project-check and exec commands accept an explicit physical root.
The tool never commits, pushes, modifies Git configuration, or copies AP
protocol files into the consuming project.
EOF
}

PROJECT_CONTRACT=ap.project.conf
PROJECT_CHILD_PATH=/usr/bin:/bin

project_clean_stage() {
    project_stage_argument=$1
    shift
    if [ "$project_stage_argument" = yes ] &&
        [ "${AP_PROJECT_CLEAN_STAGE:-}" = 1 ] &&
        [ "${PATH:-}" = "$PROJECT_CHILD_PATH" ] &&
        [ "${HOME:-}" = /nonexistent ] &&
        [ "${LC_ALL:-}" = C ] &&
        [ "${GIT_CONFIG_NOSYSTEM:-}" = 1 ]; then
        return 0
    fi

    case "$0" in
        */*) project_script=$0 ;;
        *) project_script=$(command -v "$0" 2>/dev/null || true) ;;
    esac
    [ -n "${project_script:-}" ] || fail "cannot resolve executable path for sanitized bootstrap"
    project_script_dir=${project_script%/*}
    project_script_name=${project_script##*/}
    [ "$project_script_dir" != "$project_script" ] || project_script_dir=.
    project_script_dir=$(cd "$project_script_dir" 2>/dev/null && pwd -P) ||
        fail "cannot resolve executable directory for sanitized bootstrap"
    project_script=$project_script_dir/$project_script_name

    project_loader_contamination=
    if [ "${LD_LIBRARY_PATH+x}" = x ]; then project_loader_contamination=LD_LIBRARY_PATH; fi
    if [ "${LD_PRELOAD+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}LD_PRELOAD"; fi
    if [ "${LD_AUDIT+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}LD_AUDIT"; fi
    if [ "${DYLD_LIBRARY_PATH+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}DYLD_LIBRARY_PATH"; fi
    if [ "${DYLD_FRAMEWORK_PATH+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}DYLD_FRAMEWORK_PATH"; fi
    if [ "${DYLD_INSERT_LIBRARIES+x}" = x ]; then project_loader_contamination="${project_loader_contamination}${project_loader_contamination:+
}DYLD_INSERT_LIBRARIES"; fi
    unset LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT \
        DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH DYLD_INSERT_LIBRARIES

    [ -x /usr/bin/env ] || fail "trusted /usr/bin/env is required for sanitized bootstrap"
    [ -x /usr/bin/awk ] || fail "trusted /usr/bin/awk is required for contamination classification"
    project_other_contamination=$(
        /usr/bin/env | /usr/bin/awk -F= '
            $1 == "APPIMAGE" || $1 == "APPDIR" || $1 == "PATH" ||
            $1 == "BASH_ENV" || $1 == "ENV" || $1 == "KSH_ENV" ||
            $1 == "ZDOTDIR" || $1 == "SHELLOPTS" || $1 == "BASHOPTS" ||
            $1 == "CDPATH" || $1 == "PROMPT_COMMAND" || $1 == "SSH_AUTH_SOCK" ||
            $1 ~ /^LD_/ || $1 ~ /^DYLD_/ || $1 ~ /^PYTHON/ ||
            $1 ~ /^VIRTUAL_ENV/ || $1 ~ /^GIT_/ { print $1 }
        '
    )
    project_contamination=$project_loader_contamination
    if [ -n "$project_other_contamination" ]; then
        project_contamination="${project_contamination}${project_contamination:+
}$project_other_contamination"
    fi
    exec /usr/bin/env -i \
        PATH="$PROJECT_CHILD_PATH" \
        LC_ALL=C \
        HOME=/nonexistent \
        GIT_CONFIG_NOSYSTEM=1 \
        AP_PROJECT_CLEAN_STAGE=1 \
        AP_PARENT_CONTAMINATION="$project_contamination" \
        "$project_script" --ap-internal-sanitized-stage "$@"
}

report_parent_contamination() {
    if [ -n "${AP_PARENT_CONTAMINATION:-}" ]; then
        project_names=$(printf '%s\n' "$AP_PARENT_CONTAMINATION" | tr '\n' ' ' | sed 's/ $//')
        say "WARN sanitized inherited environment classes: $project_names"
    else
        say "OK inherited environment contamination markers: none"
    fi
}

require_git() {
    command -v git >/dev/null 2>&1 || fail "git is required"
}

physical_path() {
    [ -d "$1" ] || return 1
    (cd "$1" && pwd -P)
}

make_temp_dir_in() {
    parent=$1
    template=$parent/.ap-tool.XXXXXX
    tmp=$(mktemp -d "$template") || fail "cannot create temporary directory in $parent"
    printf '%s\n' "$tmp"
}

file_mode() {
    if stat -f %Lp "$1" >/dev/null 2>&1; then
        stat -f %Lp "$1"
    else
        stat -c %a "$1"
    fi
}

script_dir() {
    case "$0" in
        */*) path=$0 ;;
        *) path=$(command -v "$0" 2>/dev/null || true) ;;
    esac
    [ -n "${path:-}" ] || fail "cannot resolve executable path"
    dir=$(dirname "$path")
    physical_path "$dir" || fail "cannot resolve executable directory"
}

normalize_ap_url() {
    case "$1" in
        https://github.com/cisarik/ap|\
        https://github.com/cisarik/ap.git|\
        https://github.com/cisarik/ap/|\
        https://github.com/cisarik/ap.git/)
            printf '%s\n' "github.com/cisarik/ap"
            ;;
        *)
            return 1
            ;;
    esac
}

require_context() {
    require_git

    tool_dir=$(script_dir)
    ap_root=$(git -C "$tool_dir" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$ap_root" ] || fail "the ap tool must live inside a Git worktree"
    ap_root=$(physical_path "$ap_root") || fail "cannot resolve AP root"
    [ "$tool_dir" = "$ap_root" ] || fail "the ap executable must be at the AP repository root"

    super_root=$(git -C "$ap_root" rev-parse --show-superproject-working-tree 2>/dev/null || true)
    [ -n "$super_root" ] || fail "this command must run from an initialized .ap submodule"
    super_root=$(physical_path "$super_root") || fail "cannot resolve superproject root"

    expected_ap="$super_root/$SUBMODULE_PATH"
    [ -d "$expected_ap" ] || fail "superproject does not contain .ap"
    expected_ap=$(physical_path "$expected_ap") || fail "cannot resolve .ap path"
    [ "$ap_root" = "$expected_ap" ] || fail "AP submodule path must be .ap"

    export ap_root super_root
}

submodule_key_for_ap() {
    [ -f "$super_root/.gitmodules" ] || fail ".gitmodules is missing"

    matches=$(git -C "$super_root" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '$2 == ".ap" { print $1 }' || true)
    count=$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')
    [ "$count" = "1" ] || fail ".gitmodules must contain exactly one submodule path .ap"

    key=$(printf '%s\n' "$matches" | sed -n '1p')
    section=${key#submodule.}
    section=${section%.path}
    [ -n "$section" ] || fail "cannot resolve .gitmodules section for .ap"
    printf '%s\n' "$section"
}

verify_canonical_identity() {
    section=$(submodule_key_for_ap)
    modules_url=$(git -C "$super_root" config -f .gitmodules --get "submodule.$section.url" 2>/dev/null || true)
    [ -n "$modules_url" ] || fail ".gitmodules is missing URL for .ap"
    normalize_ap_url "$modules_url" >/dev/null || fail ".gitmodules URL for .ap is not canonical AP"

    origin_url=$(git -C "$ap_root" config --get remote.origin.url 2>/dev/null || true)
    [ -n "$origin_url" ] || fail ".ap origin remote is missing"
    normalize_ap_url "$origin_url" >/dev/null || fail ".ap origin remote is not canonical AP"
}

gitlink_sha() {
    entry=$(git -C "$super_root" ls-files -s -- "$SUBMODULE_PATH" 2>/dev/null || true)
    [ -n "$entry" ] || fail ".ap is not recorded in the superproject index"
    set -- $entry
    mode=$1
    sha=$2
    [ "$mode" = "160000" ] || fail ".ap is not recorded as a submodule gitlink"
    printf '%s\n' "$sha"
}

ap_head() {
    git -C "$ap_root" rev-parse HEAD
}

require_gitlink_consistent() {
    recorded=$(gitlink_sha)
    current=$(ap_head)
    [ "$recorded" = "$current" ] || fail ".ap worktree HEAD does not match the superproject gitlink"
}

require_submodule_clean() {
    status=$(git -C "$ap_root" status --porcelain=v1 --untracked-files=all)
    [ -z "$status" ] || fail ".ap submodule worktree is dirty"
}

require_superproject_clean() {
    status=$(git -C "$super_root" status --porcelain=v1 --untracked-files=all)
    [ -z "$status" ] || fail "superproject worktree or index is not clean"
}

managed_block() {
    cat <<'EOF'
<!-- BEGIN MANAGED AP INTEGRATION -->
## Analytic Programming

This project uses Analytic Programming through the pinned Git submodule at `.ap/`.
The exact AP version is the commit recorded by this repository's `.ap` gitlink.

Required reading:
- All participants read `.ap/AP.md`.
- Orchestrators also read `.ap/AP_ORCHESTRATOR.md`.
- Workers also read `.ap/AP_WORKER.md`.
- Prompt structures are in `.ap/PROMPT_CONTRACTS.md`.

Project-specific rules outside this managed block remain authoritative within
their scope. Task authority comes only from the current authoritative
Orchestrator prompt.

Treat `.ap/` as read-only during ordinary project work. Protocol updates require
a separate explicit AP update task.
<!-- END MANAGED AP INTEGRATION -->
EOF
}

marker_count() {
    file=$1
    marker=$2
    if [ ! -f "$file" ]; then
        printf '%s\n' 0
        return
    fi
    grep -cF "$marker" "$file" || true
}

validate_marker_shape() {
    file=$1
    begin_count=$(marker_count "$file" "$BEGIN_MARKER")
    end_count=$(marker_count "$file" "$END_MARKER")
    [ "$begin_count" = "1" ] || return 1
    [ "$end_count" = "1" ] || return 1
    awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { if (seen_begin || seen_end) exit 1; seen_begin = 1; next }
        $0 == end { if (!seen_begin || seen_end) exit 1; seen_end = 1; next }
        END { if (!seen_begin || !seen_end) exit 1 }
    ' "$file"
}

validate_agents_block() {
    file="$super_root/AGENTS.md"
    [ -f "$file" ] || fail "AGENTS.md is missing"
    validate_marker_shape "$file" || fail "AGENTS.md managed AP block is missing or malformed"

    tmpdir=$(make_temp_dir_in "${TMPDIR:-/tmp}")
    block="$tmpdir/block"
    expected="$tmpdir/expected"
    trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

    awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { in_block = 1 }
        in_block { print }
        $0 == end { in_block = 0 }
    ' "$file" > "$block"
    managed_block > "$expected"

    cmp -s "$expected" "$block" || fail "AGENTS.md managed AP block does not match the canonical block; run ./.ap/ap init"
}

require_no_competing_governing_ap_source() {
    file="$super_root/AGENTS.md"
    [ -f "$file" ] || return 0

    competing=$(awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        function active_outside_comments(value,    active, marker) {
            active = ""
            while (value != "") {
                if (in_comment) {
                    marker = index(value, "-->")
                    if (!marker) return active
                    value = substr(value, marker + 3)
                    in_comment = 0
                } else {
                    marker = index(value, "<!--")
                    if (!marker) return active value
                    active = active substr(value, 1, marker - 1)
                    value = substr(value, marker + 4)
                    in_comment = 1
                }
            }
            return active
        }
        function normalize_leading_list_markers(value,    previous) {
            while (value ~ /^[[:space:]]*([-+*][[:space:]]+|[0-9]+[.)][[:space:]]+)/) {
                previous = value
                sub(/^[[:space:]]*([-+*][[:space:]]+|[0-9]+[.)][[:space:]]+)/, "", value)
                if (value == previous) break
                list_item = 1
            }
            return value
        }
        $0 == begin { in_managed = 1; next }
        $0 == end { in_managed = 0; next }
        in_managed { next }
        {
            line = $0
            list_item = 0
            line = normalize_leading_list_markers(line)
        }
        /^[[:space:]]*>/ { next }
        line ~ /^[[:space:]]*>/ { next }
        in_fence {
            if (line ~ /^[[:space:]]*(```|~~~)/) in_fence = 0
            next
        }
        {
            comment_touched = in_comment
            line = active_outside_comments(line)
            if (comment_touched || index($0, "<!--")) {
                sub(/^[[:space:]]*/, "", line)
            }
            line = normalize_leading_list_markers(line)
        }
        line ~ /^[[:space:]]*>/ { next }
        line ~ /^[[:space:]]*(```|~~~)/ {
            in_fence = 1
            next
        }
        {
            if (list_item) sub(/^[[:space:]]*/, "", line)
            if (line ~ /^(Governing AP variant|Governing AP source|Governing AP repository|Additional governing AP source|Rules from non-governing AP variant|Apply governing AP rules from|Protocol rules also imported from):[[:space:]]*/) {
                print $0
            }
        }
    ' "$file")
    [ -z "$competing" ] ||
        fail "AGENTS.md declares another governing AP source, variant, or rule import outside the managed block"
}

resolve_stable_variant() {
    verify_canonical_identity
    require_gitlink_consistent
    validate_agents_block
    require_no_competing_governing_ap_source
    printf '%s\n' stable
}

write_agents_block() {
    file="$super_root/AGENTS.md"
    [ ! -L "$file" ] || fail "refusing to modify symlink AGENTS.md"

    begin_count=$(marker_count "$file" "$BEGIN_MARKER")
    end_count=$(marker_count "$file" "$END_MARKER")

    target_dir=$(dirname "$file")
    tmpdir=$(make_temp_dir_in "$target_dir")
    block="$tmpdir/block"
    out="$tmpdir/out"
    managed_block > "$block"

    cleanup_tmp() {
        rm -rf "$tmpdir"
    }
    trap cleanup_tmp EXIT HUP INT TERM

    if [ "$begin_count" = "0" ] && [ "$end_count" = "0" ]; then
        if [ -f "$file" ]; then
            cat "$file" > "$out"
            printf '\n\n' >> "$out"
            cat "$block" >> "$out"
        else
            {
                printf '%s\n\n' "# Agent Instructions"
                cat "$block"
            } > "$out"
        fi
    elif [ "$begin_count" = "1" ] && [ "$end_count" = "1" ]; then
        validate_marker_shape "$file" || fail "AGENTS.md managed AP markers are malformed"
        awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" -v block="$block" '
            $0 == begin {
                while ((getline line < block) > 0) print line
                in_block = 1
                next
            }
            $0 == end {
                in_block = 0
                next
            }
            in_block { next }
            { print }
        ' "$file" > "$out"
    else
        fail "AGENTS.md contains duplicate or conflicting managed AP markers"
    fi

    if [ -f "$file" ]; then
        mode=$(file_mode "$file") || fail "cannot read AGENTS.md mode"
        chmod "$mode" "$out" || fail "cannot preserve AGENTS.md mode"
    fi

    if [ "${AP_TEST_FAIL_BEFORE_AGENTS_MV:-}" = "1" ]; then
        fail "test-requested failure before AGENTS.md publication"
    fi

    if [ -f "$file" ] && cmp -s "$file" "$out"; then
        say "AGENTS.md unchanged"
    else
        mv "$out" "$file"
        say "AGENTS.md changed"
    fi
}

legacy_artifacts() {
    confirmed=
    review=
    for artifact in \
        AP.md APv2.md APv3.md AP_ORCHESTRATOR.md AP_WORKER.md \
        PROMPT_CONTRACTS.md ARTIFACT_LIFECYCLE.md BOOT_ORCHESTRATOR.md \
        BOOT_WORKER.md NEXT_ORCHESTRATOR.md NEXT_WORKER.md WORKERS.md
    do
        path=$super_root/$artifact
        [ -f "$path" ] || continue
        if is_confirmed_ap_copy "$artifact" "$path"; then
            confirmed="$confirmed $artifact"
        elif is_ap_session_artifact "$artifact" "$path"; then
            review="$review $artifact(session-state)"
        else
            review="$review $artifact(ambiguous-name)"
        fi
    done
    [ -n "$review" ] && printf 'WARN legacy-looking same-name files require review:%s\n' "$review" >&2
    [ -n "$confirmed" ] && printf '%s\n' "$confirmed"
    return 0
}

is_confirmed_ap_copy() {
    artifact=$1
    path=$2
    case "$artifact" in
        AP.md|APv2.md|APv3.md)
            head -n 5 "$path" | grep -E 'Analytic Programming Protocol' >/dev/null
            ;;
        AP_ORCHESTRATOR.md)
            head -n 5 "$path" | grep -F 'Orchestrator Handbook for Analytic Programming' >/dev/null
            ;;
        AP_WORKER.md)
            head -n 5 "$path" | grep -F 'Worker Handbook for Analytic Programming' >/dev/null
            ;;
        PROMPT_CONTRACTS.md)
            head -n 20 "$path" | grep -F 'Analytic Programming' >/dev/null && head -n 5 "$path" | grep -F 'Prompt Contracts' >/dev/null
            ;;
        ARTIFACT_LIFECYCLE.md)
            head -n 20 "$path" | grep -F 'Analytic Programming' >/dev/null && head -n 5 "$path" | grep -F 'Artifact Lifecycle' >/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

is_ap_session_artifact() {
    artifact=$1
    path=$2
    case "$artifact" in
        BOOT_ORCHESTRATOR.md|BOOT_WORKER.md|NEXT_ORCHESTRATOR.md|NEXT_WORKER.md|WORKERS.md)
            head -n 20 "$path" | grep -F 'Analytic Programming' >/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

cmd_init() {
    require_context
    verify_canonical_identity
    require_gitlink_consistent
    require_submodule_clean
    require_no_competing_governing_ap_source
    write_agents_block
    variant=$(resolve_stable_variant)
    say "OK resolved governing variant: $variant"
    say "ap init: PASS"
}

cmd_doctor() {
    require_context
    mode=${1:-strict}
    say "OK containing Git repository: $super_root"
    verify_canonical_identity
    say "OK canonical AP identity"
    recorded=$(gitlink_sha)
    current=$(ap_head)
    say "superproject recorded AP commit: $recorded"
    say ".ap worktree AP commit: $current"
    if [ "$mode" = "strict" ]; then
        [ "$recorded" = "$current" ] || fail ".ap HEAD $current does not match gitlink $recorded"
        say "OK strict pinned AP commit"
    elif [ "$mode" = "candidate" ]; then
        [ "$recorded" != "$current" ] || fail ".ap candidate mode requires a changed AP checkout"
        verify_candidate_superproject_state
        say "OK AP candidate checkout differs from the recorded gitlink"
    else
        fail "unknown doctor mode"
    fi
    require_submodule_clean
    say "OK .ap submodule clean"
    validate_agents_block
    say "OK managed AGENTS.md block"
    require_no_competing_governing_ap_source
    legacy=$(legacy_artifacts)
    [ -z "$legacy" ] || fail "confirmed copied AP artifacts present: $(printf '%s' "$legacy" | tr '\n' ' ')"
    if [ "$mode" = "strict" ]; then
        variant=$(resolve_stable_variant)
        say "OK resolved governing variant: $variant"
        say "ap doctor: PASS"
    else
        say "ap doctor --candidate: PASS"
    fi
}

verify_candidate_superproject_state() {
    status=$(git -C "$super_root" status --porcelain=v1 --untracked-files=all)
    filtered=$(printf '%s\n' "$status" | sed '/^$/d; /^[ MARC][ MD] \.ap$/d')
    [ -z "$filtered" ] || fail "candidate validation allows only the .ap gitlink to differ in the superproject"
}

fetch_remote_main() {
    git -C "$ap_root" fetch --quiet origin refs/heads/main || fail "cannot fetch canonical AP origin main"
    git -C "$ap_root" rev-parse FETCH_HEAD^{commit} || fail "cannot resolve canonical AP origin main"
}

classify_update() {
    current=$1
    available=$2
    if [ "$current" = "$available" ]; then
        printf '%s\n' current
    elif git -C "$ap_root" merge-base --is-ancestor "$current" "$available"; then
        printf '%s\n' forward
    elif git -C "$ap_root" merge-base --is-ancestor "$available" "$current"; then
        printf '%s\n' behind
    else
        printf '%s\n' divergent
    fi
}

require_target_ap_tool() {
    target=$1
    entry=$(git -C "$ap_root" ls-tree "$target" -- ap 2>/dev/null || true)
    set -- $entry
    [ "${1:-}" = "100755" ] && [ "${4:-}" = "ap" ] || fail "target AP commit does not contain an executable ap tool"
}

cmd_update_check() {
    require_context
    verify_canonical_identity
    require_submodule_clean
    require_gitlink_consistent
    current=$(ap_head)
    available=$(fetch_remote_main)
    classification=$(classify_update "$current" "$available")
    say "current pinned AP commit: $current"
    say "available canonical origin/main commit: $available"
    case "$classification" in
        current)
            say "update available: no"
            ;;
        forward)
            say "update available: yes"
            ;;
        behind)
            fail "canonical origin/main is behind the current AP commit; normal update refused"
            ;;
        divergent)
            fail "canonical origin/main diverges from the current AP commit; normal update refused"
            ;;
    esac
}

cmd_update_apply() {
    require_context
    verify_canonical_identity
    require_gitlink_consistent
    require_submodule_clean
    require_superproject_clean

    old=$(ap_head)
    new=$(fetch_remote_main)
    classification=$(classify_update "$old" "$new")

    say "old AP commit: $old"
    say "new AP commit: $new"

    if [ "$classification" = "current" ]; then
        say "ap update --apply: no update available"
        return
    fi
    [ "$classification" = "forward" ] || fail "normal update requires current AP HEAD to be an ancestor of canonical origin/main"
    require_target_ap_tool "$new"

    git -C "$ap_root" checkout --detach --quiet "$new" || fail "failed to move .ap to $new"
    say "ap update --apply: moved .ap to $new"
    say "Review with: git diff --submodule"
    say "Validate candidate with: ./.ap/ap doctor --candidate"
    say "Commit in the superproject only after compatibility review: git add .ap && git commit"
}

project_cleanup() {
    case "${project_tmp:-}" in
        /tmp/ap-project.*|/private/tmp/ap-project.*|/var/tmp/ap-project.*)
            rm -rf "$project_tmp"
            ;;
    esac
}

project_require_root() {
    project_requested_root=$1
    [ -n "$project_requested_root" ] || fail "--root requires a value"
    case "$project_requested_root" in
        /*) ;;
        *) fail "--root must be an absolute physical path" ;;
    esac
    project_root=$(physical_path "$project_requested_root") || fail "project root is not a directory"
    [ "$project_root" = "$project_requested_root" ] || fail "--root must already be the physical project root: $project_root"
    project_git_root=$(git -C "$project_root" rev-parse --show-toplevel 2>/dev/null || true)
    [ -n "$project_git_root" ] || fail "--root is not a Git worktree"
    project_git_root=$(physical_path "$project_git_root") || fail "cannot resolve Git project root"
    [ "$project_git_root" = "$project_root" ] || fail "--root must name the Git worktree top level"
}

project_resolve_baseline() {
    project_requested_baseline=$1
    case "$project_requested_baseline" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]* ) ;;
        *) fail "--baseline must be a full lowercase commit object ID" ;;
    esac
    [ "${#project_requested_baseline}" -eq 40 ] || fail "--baseline must be a full 40-character commit object ID"
    project_baseline=$(git -C "$project_root" rev-parse --verify "$project_requested_baseline^{commit}" 2>/dev/null || true)
    [ "$project_baseline" = "$project_requested_baseline" ] || fail "baseline commit is missing or does not resolve exactly"
    git -C "$project_root" cat-file -e "$project_baseline:$PROJECT_CONTRACT" 2>/dev/null ||
        fail "baseline $project_baseline does not contain $PROJECT_CONTRACT"
}

project_config() {
    if [ "$project_contract_mode" = baseline ]; then
        git -C "$project_root" config --no-includes --blob "$project_baseline:$PROJECT_CONTRACT" "$@"
    else
        git -C "$project_root" config --no-includes --file "$project_root/$PROJECT_CONTRACT" "$@"
    fi
}

project_count_key() {
    project_count=$(project_config --null --get-all "$1" 2>/dev/null |
        awk 'BEGIN { RS="\0" } { count++ } END { print count + 0 }')
    printf '%s\n' "$project_count"
}

project_read_singleton() {
    project_read_key=$1
    project_read_label=$2
    project_read_required=$3
    project_read_count=$(project_count_key "$project_read_key")
    if [ "$project_read_required" = required ]; then
        [ "$project_read_count" -eq 1 ] || fail "$project_read_label must occur exactly once"
    else
        [ "$project_read_count" -le 1 ] || fail "$project_read_label may occur at most once"
        if [ "$project_read_count" -eq 0 ]; then
            project_read_value=
            return
        fi
    fi
    project_read_value=$(project_config --get "$project_read_key") || fail "cannot read $project_read_label"
    case "$project_read_value" in
        *'
'*) fail "$project_read_label must not contain a newline" ;;
    esac
    [ -n "$project_read_value" ] || fail "$project_read_label must not be empty"
}

project_validate_relative_path() {
    project_path_value=$1
    project_path_label=$2
    project_path_allow_dot=$3
    [ -n "$project_path_value" ] || fail "$project_path_label must not be empty"
    case "$project_path_value" in
        /*) fail "$project_path_label must be project-relative" ;;
        *//*|*/./*|./*|*/.) fail "$project_path_label is not a normalized project-relative path" ;;
    esac
    [ "$project_path_allow_dot" = yes ] || [ "$project_path_value" != . ] ||
        fail "$project_path_label must name a path below the project root"
    project_old_ifs=$IFS
    IFS=/
    set -- $project_path_value
    IFS=$project_old_ifs
    for project_component in "$@"; do
        [ "$project_component" != .. ] || fail "$project_path_label must not traverse with .."
        [ -n "$project_component" ] || fail "$project_path_label contains an empty component"
    done
}

project_require_inside_root() {
    project_inside_path=$1
    project_inside_label=$2
    case "$project_inside_path" in
        "$project_root"|"$project_root"/*) ;;
        *) fail "$project_inside_label resolves outside the project root" ;;
    esac
}

project_expected_id() {
    project_origin=$(git -C "$project_root" config --get remote.origin.url 2>/dev/null || true)
    [ -n "$project_origin" ] || fail "remote.origin.url is required to verify projectId"
    project_origin=${project_origin%/}
    project_origin=${project_origin%.git}
    case "$project_origin" in
        *://*) project_origin_path=${project_origin#*://}; project_origin_path=${project_origin_path#*/} ;;
        *@*:*) project_origin_path=${project_origin#*:} ;;
        *) fail "remote.origin.url cannot be mapped to a stable owner/project identifier" ;;
    esac
    project_origin_owner=${project_origin_path%/*}
    project_origin_repo=${project_origin_path##*/}
    project_origin_owner=${project_origin_owner##*/}
    [ -n "$project_origin_owner" ] && [ -n "$project_origin_repo" ] ||
        fail "remote.origin.url cannot be mapped to a stable owner/project identifier"
    printf '%s/%s\n' "$project_origin_owner" "$project_origin_repo"
}

project_validate_contract() {
    project_tmp=$(mktemp -d "${TMPDIR:-/tmp}/ap-project.XXXXXX") || fail "cannot create project-validation temporary directory"
    trap project_cleanup EXIT HUP INT TERM
    project_keys=$project_tmp/keys
    project_operations=$project_tmp/operations
    project_argv=$project_tmp/argv

    if [ "$project_contract_mode" = candidate ]; then
        [ -f "$project_root/$PROJECT_CONTRACT" ] || fail "candidate $PROJECT_CONTRACT is missing"
        [ ! -L "$project_root/$PROJECT_CONTRACT" ] || fail "candidate $PROJECT_CONTRACT must not be a symlink"
    fi
    project_config --list >/dev/null 2>&1 || fail "$PROJECT_CONTRACT is not valid Git-config syntax"
    project_config --name-only --get-regexp '.*' > "$project_keys" 2>/dev/null ||
        fail "$PROJECT_CONTRACT contains no configuration"

    : > "$project_operations"
    while IFS= read -r project_key; do
        project_key_lower=$(printf '%s\n' "$project_key" | tr '[:upper:]' '[:lower:]')
        case "$project_key_lower" in
            include.*|includeif.*) fail "include directives are forbidden in $PROJECT_CONTRACT" ;;
            ap.schemaversion|ap.projectid|ap.environmentpolicy|\
            runtime.cpython.kind|runtime.cpython.executable|runtime.cpython.requiredversion|\
            runtime.cpython.sourceroot|runtime.cpython.provenancemodule) ;;
            operation.*.workingdirectory|operation.*.argv|operation.*.allowtrailingargv)
                project_operation_id=${project_key_lower#operation.}
                project_operation_id=${project_operation_id%.*}
                case "$project_operation_id" in
                    ''|*[!a-z0-9_-]*|[-_]* ) fail "invalid operation identifier in key: $project_key" ;;
                esac
                printf '%s\n' "$project_operation_id" >> "$project_operations"
                ;;
            extension.*.*) ;;
            *) fail "unknown schema-v1 section or field: $project_key" ;;
        esac
    done < "$project_keys"
    sort -u "$project_operations" -o "$project_operations"
    [ -s "$project_operations" ] || fail "schema v1 requires at least one declared operation"

    project_read_singleton ap.schemaversion schemaVersion required
    project_schema_version=$project_read_value
    [ "$project_schema_version" = 1 ] || fail "unsupported project contract schemaVersion: $project_schema_version"
    project_read_singleton ap.projectid projectId required
    project_id=$project_read_value
    project_id_expected=$(project_expected_id)
    [ "$project_id" = "$project_id_expected" ] ||
        fail "projectId mismatch: contract names $project_id but repository identity is $project_id_expected"
    project_read_singleton ap.environmentpolicy environmentPolicy required
    project_environment_policy=$project_read_value
    [ "$project_environment_policy" = sanitized-v1 ] || fail "environmentPolicy must be sanitized-v1"

    project_read_singleton runtime.cpython.kind runtime.cpython.kind required
    project_runtime_kind=$project_read_value
    [ "$project_runtime_kind" = cpython ] || fail "runtime.cpython.kind must be cpython"
    project_read_singleton runtime.cpython.executable runtime.cpython.executable required
    project_runtime_relative=$project_read_value
    project_validate_relative_path "$project_runtime_relative" runtime.cpython.executable no
    project_read_singleton runtime.cpython.requiredversion runtime.cpython.requiredVersion required
    project_runtime_version=$project_read_value
    case "$project_runtime_version" in
        [0-9].[0-9]|[0-9].[0-9][0-9]) ;;
        *) fail "runtime.cpython.requiredVersion must be a major.minor version" ;;
    esac
    project_read_singleton runtime.cpython.sourceroot runtime.cpython.sourceRoot optional
    project_source_relative=$project_read_value
    project_read_singleton runtime.cpython.provenancemodule runtime.cpython.provenanceModule optional
    project_provenance_module=$project_read_value
    if [ -n "$project_provenance_module" ] && [ -z "$project_source_relative" ]; then
        fail "runtime.cpython.provenanceModule requires sourceRoot"
    fi
    if [ -n "$project_provenance_module" ]; then
        case "$project_provenance_module" in
            *[!A-Za-z0-9_.]*|.*|*.|*..*) fail "runtime.cpython.provenanceModule is not a valid module name" ;;
        esac
    fi

    if [ -n "$project_source_relative" ]; then
        project_validate_relative_path "$project_source_relative" runtime.cpython.sourceRoot yes
        [ -d "$project_root/$project_source_relative" ] || fail "declared CPython sourceRoot does not exist"
        project_source_root=$(physical_path "$project_root/$project_source_relative") || fail "cannot resolve CPython sourceRoot"
        project_require_inside_root "$project_source_root" runtime.cpython.sourceRoot
    else
        project_source_root=
    fi

    project_runtime_entry=$project_root/$project_runtime_relative
    [ -e "$project_runtime_entry" ] || fail "declared CPython executable does not exist; STOP and report the mismatch without repairing the environment"
    [ -x "$project_runtime_entry" ] || fail "declared CPython executable is not executable; STOP and report the mismatch without repairing the environment"
    project_runtime_executable=$(readlink -f "$project_runtime_entry" 2>/dev/null || true)
    [ -n "$project_runtime_executable" ] && [ -f "$project_runtime_executable" ] && [ -x "$project_runtime_executable" ] ||
        fail "declared CPython executable symlink chain cannot be resolved safely; STOP and report the mismatch"

    while IFS= read -r project_operation_id; do
        project_read_singleton "operation.$project_operation_id.workingdirectory" "operation.$project_operation_id.workingDirectory" required
        project_workdir_relative=$project_read_value
        project_validate_relative_path "$project_workdir_relative" "operation.$project_operation_id.workingDirectory" yes
        [ -d "$project_root/$project_workdir_relative" ] || fail "operation $project_operation_id workingDirectory does not exist"
        project_workdir=$(physical_path "$project_root/$project_workdir_relative") || fail "cannot resolve operation workingDirectory"
        project_require_inside_root "$project_workdir" "operation $project_operation_id workingDirectory"
        project_read_singleton "operation.$project_operation_id.allowtrailingargv" "operation.$project_operation_id.allowTrailingArgv" required
        case "$project_read_value" in true|false) ;; *) fail "operation.$project_operation_id.allowTrailingArgv must be true or false" ;; esac
        project_argv_count=$(project_count_key "operation.$project_operation_id.argv")
        [ "$project_argv_count" -ge 1 ] || fail "operation.$project_operation_id.argv requires at least one fixed argument"
        project_config --get-all "operation.$project_operation_id.argv" > "$project_argv.values" || fail "cannot read operation argv"
        [ "$(wc -l < "$project_argv.values" | tr -d ' ')" -eq "$project_argv_count" ] ||
            fail "operation.$project_operation_id.argv values must not contain newlines"
        while IFS= read -r project_fixed_arg; do
            [ -n "$project_fixed_arg" ] || fail "operation.$project_operation_id.argv values must not be empty"
        done < "$project_argv.values"
    done < "$project_operations"
}

project_validate_cpython() {
    project_probe='import importlib.util, os, sys, sysconfig
def stop(message):
    print("ap: CPython validation failed: " + message + "; STOP and report the mismatch; do not repair the environment", file=sys.stderr)
    raise SystemExit(1)
def inside(path, root):
    try:
        return os.path.commonpath((os.path.realpath(path), os.path.realpath(root))) == os.path.realpath(root)
    except ValueError:
        return False
expected_version, expected_executable, source_root, module = sys.argv[1:5]
observed_version = "%d.%d" % sys.version_info[:2]
if observed_version != expected_version:
    stop("required Python " + expected_version + ", observed " + observed_version)
executable = os.path.realpath(sys.executable)
if executable != os.path.realpath(expected_executable):
    stop("sys.executable does not match the declared executable target")
prefix = os.path.realpath(sys.prefix)
base_prefix = os.path.realpath(sys.base_prefix)
stdlib = os.path.realpath(sysconfig.get_path("stdlib") or "")
import encodings
encodings_origin = os.path.realpath(encodings.__file__ or "")
if not all(os.path.isabs(p) and os.path.exists(p) for p in (executable, prefix, base_prefix, stdlib, encodings_origin)):
    stop("executable, prefixes, stdlib, or encodings origin is missing or non-absolute")
if not (inside(stdlib, prefix) or inside(stdlib, base_prefix)):
    stop("stdlib is inconsistent with sys.prefix and sys.base_prefix")
if not inside(encodings_origin, stdlib):
    stop("encodings resolves outside the interpreter stdlib")
for value in (executable, prefix, base_prefix, stdlib, encodings_origin):
    lowered = value.lower()
    if "appimage" in lowered or "/.mount_" in lowered or "cursor" in lowered:
        stop("runtime provenance resolves through an AppImage/Cursor path")
if not sys.flags.no_user_site or not sys.dont_write_bytecode:
    stop("user-site behavior and bytecode writes are not disabled")
observed_pythonpath = os.environ.get("PYTHONPATH", "")
if source_root:
    if os.path.realpath(observed_pythonpath) != os.path.realpath(source_root):
        stop("PYTHONPATH is not exactly the declared sourceRoot")
    occurrences = sum(1 for item in sys.path if item and os.path.realpath(item) == os.path.realpath(source_root))
    if occurrences != 1:
        stop("declared sourceRoot is not injected exactly once")
else:
    if observed_pythonpath:
        stop("PYTHONPATH is present without a declared sourceRoot")
if module:
    spec = importlib.util.find_spec(module)
    if spec is None or not spec.origin or not inside(spec.origin, source_root):
        stop("provenance module resolves outside the declared sourceRoot")
print("OK CPython runtime: " + observed_version)
print("OK CPython executable: " + executable)
print("OK CPython stdlib: " + stdlib)
print("OK CPython encodings: " + encodings_origin)'
    project_probe_status=0
    if [ -n "$project_source_root" ]; then
        /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$project_source_root" \
            "$project_runtime_executable" -s -B -c "$project_probe" \
            "$project_runtime_version" "$project_runtime_executable" "$project_source_root" "$project_provenance_module" ||
            project_probe_status=$?
    else
        /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            "$project_runtime_executable" -s -B -c "$project_probe" \
            "$project_runtime_version" "$project_runtime_executable" "" "" ||
            project_probe_status=$?
    fi
    [ "$project_probe_status" -eq 0 ] ||
        fail "CPython runtime validation failed; STOP and report the mismatch without repairing Python or the workstation"
}

project_check_common() {
    report_parent_contamination
    require_git
    project_require_root "$1"
    project_contract_mode=$2
    if [ "$project_contract_mode" = baseline ]; then
        project_resolve_baseline "$3"
        say "OK trusted baseline contract: $project_baseline:$PROJECT_CONTRACT"
    else
        project_baseline=
        say "NOTICE candidate validation is configuration/readiness evidence only; execution trust: no"
    fi
    project_validate_contract
    project_validate_cpython
    say "OK project contract schema: 1"
    say "OK project identity: $project_id"
    say "OK environment policy: $project_environment_policy"
}

cmd_project() {
    [ "${1:-}" = check ] || fail "project requires check"
    shift
    project_cli_root=
    project_cli_baseline=
    project_cli_mode=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root) [ "$#" -ge 2 ] || fail "--root requires a value"; project_cli_root=$2; shift 2 ;;
            --baseline) [ "$#" -ge 2 ] || fail "--baseline requires a value"; [ -z "$project_cli_mode" ] || fail "choose exactly one of --baseline or --candidate"; project_cli_mode=baseline; project_cli_baseline=$2; shift 2 ;;
            --candidate) [ -z "$project_cli_mode" ] || fail "choose exactly one of --baseline or --candidate"; project_cli_mode=candidate; shift ;;
            *) fail "unknown project check option: $1" ;;
        esac
    done
    [ -n "$project_cli_root" ] || fail "project check requires --root"
    [ -n "$project_cli_mode" ] || fail "project check requires --baseline or --candidate"
    project_check_common "$project_cli_root" "$project_cli_mode" "$project_cli_baseline"
    if [ "$project_cli_mode" = baseline ]; then
        say "ap project check --baseline: PASS"
    else
        say "ap project check --candidate: PASS (non-authorizing)"
    fi
}

cmd_exec() {
    project_cli_root=
    project_cli_baseline=
    project_cli_operation=
    project_cli_separator=no
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root) [ "$#" -ge 2 ] || fail "--root requires a value"; project_cli_root=$2; shift 2 ;;
            --baseline) [ "$#" -ge 2 ] || fail "--baseline requires a value"; project_cli_baseline=$2; shift 2 ;;
            --operation) [ "$#" -ge 2 ] || fail "--operation requires a value"; project_cli_operation=$2; shift 2 ;;
            --) project_cli_separator=yes; shift; break ;;
            *) fail "unknown exec option: $1" ;;
        esac
    done
    [ -n "$project_cli_root" ] || fail "exec requires --root"
    [ -n "$project_cli_baseline" ] || fail "exec requires --baseline"
    [ -n "$project_cli_operation" ] || fail "exec requires --operation"
    case "$project_cli_operation" in ''|*[!a-z0-9_-]*|[-_]*) fail "invalid operation identifier" ;; esac
    project_trailing_count=$#
    [ "$project_cli_separator" = yes ] || [ "$project_trailing_count" -eq 0 ] || fail "trailing argv must follow --"

    project_check_common "$project_cli_root" baseline "$project_cli_baseline"
    grep -Fx "$project_cli_operation" "$project_operations" >/dev/null 2>&1 || fail "operation is not declared by the trusted baseline: $project_cli_operation"
    project_read_singleton "operation.$project_cli_operation.allowtrailingargv" "operation.$project_cli_operation.allowTrailingArgv" required
    project_allow_trailing=$project_read_value
    if [ "$project_trailing_count" -gt 0 ] && [ "$project_allow_trailing" != true ]; then
        fail "operation $project_cli_operation does not allow trailing argv"
    fi
    project_read_singleton "operation.$project_cli_operation.workingdirectory" "operation.$project_cli_operation.workingDirectory" required
    project_exec_workdir=$(physical_path "$project_root/$project_read_value") || fail "cannot resolve operation workingDirectory"
    project_config --get-all "operation.$project_cli_operation.argv" > "$project_argv"
    project_fixed_reverse=$(sed '1!G;h;$!d' "$project_argv")
    while IFS= read -r project_fixed_arg; do
        set -- "$project_fixed_arg" "$@"
    done <<EOF
$project_fixed_reverse
EOF
    set -- "$project_runtime_executable" "$@"

    if ! git -C "$project_root" diff --quiet --no-ext-diff --no-textconv "$project_baseline" -- "$PROJECT_CONTRACT"; then
        fail "worktree/baseline $PROJECT_CONTRACT drift forbids execution"
    fi
    say "OK execution trust: baseline $project_baseline"
    say "OK operation: $project_cli_operation"
    say "OK direct argv execution with absolute argv[0]"
    project_cleanup
    trap - EXIT HUP INT TERM
    cd "$project_exec_workdir"
    if [ -n "$project_source_root" ]; then
        exec /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$project_source_root" \
            AP_PROJECT_ROOT="$project_root" AP_BASELINE="$project_baseline" AP_OPERATION="$project_cli_operation" \
            "$@"
    else
        exec /usr/bin/env -i PATH="$PROJECT_CHILD_PATH" LC_ALL=C LANG=C \
            PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            AP_PROJECT_ROOT="$project_root" AP_BASELINE="$project_baseline" AP_OPERATION="$project_cli_operation" \
            "$@"
    fi
}

project_stage_argument=no
if [ "${1:-}" = --ap-internal-sanitized-stage ]; then
    project_stage_argument=yes
    shift
fi

case "${1:-help}" in
    init)
        [ "$#" -eq 1 ] || fail "init takes no arguments"
        cmd_init
        ;;
    doctor)
        if [ "$#" -eq 1 ]; then
            cmd_doctor strict
        elif [ "$#" -eq 2 ] && [ "$2" = "--candidate" ]; then
            cmd_doctor candidate
        else
            fail "doctor takes no argument or --candidate"
        fi
        ;;
    project)
        project_clean_stage "$project_stage_argument" "$@"
        shift
        cmd_project "$@"
        ;;
    exec)
        project_clean_stage "$project_stage_argument" "$@"
        shift
        cmd_exec "$@"
        ;;
    update)
        [ "$#" -eq 2 ] || fail "update requires --check or --apply"
        case "$2" in
            --check) cmd_update_check ;;
            --apply) cmd_update_apply ;;
            *) fail "unknown update option: $2" ;;
        esac
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
